        "paid_amount",
        "base_paid_amount",
        "write_off_amount",
        "base_write_off_amount",
        "change_amount",
        "base_change_amount",
        "loyalty_amount",
        "base_loyalty_amount",
        "loyalty_points",
    ]:
        if _has_field("Sales Invoice", fieldname):
            try:
                if fieldname == "pos_profile":
                    doc.set(fieldname, None)
                else:
                    doc.set(fieldname, 0)
            except Exception:
                pass

    try:
        doc.set("payments", [])
    except Exception:
        pass


def _kpws_bypass_pos_return_validation(doc):
    def _noop(*args, **kwargs):
        return None

    try:
        doc.validate_pos = _noop
    except Exception:
        pass

    try:
        doc.validate_pos_paid_amount = _noop
    except Exception:
