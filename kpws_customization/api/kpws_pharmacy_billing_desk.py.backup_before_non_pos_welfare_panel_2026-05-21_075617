import json
import frappe
from frappe import _
from frappe.utils import cint, flt, getdate, nowdate


SETTINGS_DOCTYPE = "KPWS Pharmacy Billing Settings"
PAGE_NAME = "kpws-pharmacy-billing"

ALLOWED_ROLES = {
    "System Manager",
    "Accounts Manager",
    "Accounts User",
    "Sales Manager",
    "Sales User",
    "KPWS Pharmacy User",
}

PATIENT_FIELDS_ON_SI = (
    "patient",
    "custom_patient",
    "healthcare_patient",
    "custom_healthcare_patient",
    "patient_id",
    "custom_patient_id",
)

PRF_DOCTYPES = (
    "Patient Registration Form",
    "Patient Registeration Form",
)


def _require_role():
    roles = set(frappe.get_roles())
    if not roles.intersection(ALLOWED_ROLES):
        frappe.throw(_("Not permitted for KPWS Pharmacy Billing Desk."), frappe.PermissionError)


def _json(value):
    if not value:
        return {}
    if isinstance(value, str):
        return json.loads(value)
    return value


def _list(value):
    if not value:
        return []
    if isinstance(value, str):
        return json.loads(value)
    return value


def _has_field(doctype, fieldname):
    try:
        return frappe.get_meta(doctype).has_field(fieldname)
    except Exception:
        return False


def _set_if_has(doc, fieldname, value):
    if _has_field(doc.doctype, fieldname):
        doc.set(fieldname, value)


def _first_company():
    company = frappe.defaults.get_user_default("Company")
    if company:
        return company

    company = frappe.db.get_single_value("Global Defaults", "default_company")
    if company:
        return company

    return frappe.db.get_value("Company", {}, "name")


def _ensure_settings_doc():
    if not frappe.db.exists("DocType", SETTINGS_DOCTYPE):
        frappe.throw(_("Settings DocType is not installed."))

    doc = frappe.get_single(SETTINGS_DOCTYPE)

    if not doc.company:
        doc.company = _first_company()

    if not doc.pharmacy_warehouse and frappe.db.exists("Warehouse", "Pharmacy - KPWS"):
        doc.pharmacy_warehouse = "Pharmacy - KPWS"

    if not doc.cash_price_list:
        for pl in ("SPW – Selling Price Welfare", "SPW - Selling Price Welfare", "Standard Selling"):
            if frappe.db.exists("Price List", pl):
                doc.cash_price_list = pl
                break

    if not doc.welfare_price_list:
        for pl in ("SPW – Selling Price Welfare", "SPW - Selling Price Welfare", "Standard Selling"):
            if frappe.db.exists("Price List", pl):
                doc.welfare_price_list = pl
                break

    if not doc.panel_price_list:
        for pl in ("SPP – Selling Price Panel", "SPP - Selling Price Panel", "Standard Selling"):
            if frappe.db.exists("Price List", pl):
                doc.panel_price_list = pl
                break

    if not doc.default_mode_of_payment:
        mop = frappe.db.get_value("Mode of Payment", {"enabled": 1}, "name") or frappe.db.get_value("Mode of Payment", {}, "name")
        if mop:
            doc.default_mode_of_payment = mop

    doc.save(ignore_permissions=True)
    frappe.db.commit()
    return doc


def _settings_dict(doc=None):
    doc = doc or _ensure_settings_doc()
    fields = [
        "company",
        "pharmacy_warehouse",
        "cash_price_list",
        "welfare_price_list",
        "panel_price_list",
        "default_mode_of_payment",
        "default_cash_customer",
        "require_cash_payment",
        "auto_submit_invoice",
        "update_stock",
        "enforce_patient_status",
        "enforce_pharmacy_stock",
        "block_missing_price",
        "apply_registration_percentage_as_discount",
        "allow_manual_rate",
        "print_format",
    ]
    return {field: doc.get(field) for field in fields}


def _patient_name(patient_doc):
    for fieldname in ("patient_name", "full_name"):
        if _has_field("Patient", fieldname) and patient_doc.get(fieldname):
            return patient_doc.get(fieldname)

    parts = []
    for fieldname in ("first_name", "middle_name", "last_name"):
        if _has_field("Patient", fieldname) and patient_doc.get(fieldname):
            parts.append(patient_doc.get(fieldname))

    return " ".join(parts).strip() or patient_doc.name


def _patient_mr(patient_doc):
    for fieldname in ("custom_reference_number", "custom_mr_number", "mr_number", "patient_mr_number"):
        if _has_field("Patient", fieldname) and patient_doc.get(fieldname):
            return patient_doc.get(fieldname)
    return patient_doc.name


def _patient_customer(patient_doc):
    for fieldname in ("customer", "custom_customer", "custom_patient_customer"):
        if _has_field("Patient", fieldname) and patient_doc.get(fieldname):
            return patient_doc.get(fieldname)
    return None


def _latest_registration(patient):
    doctype = None
    for dt in PRF_DOCTYPES:
        if frappe.db.exists("DocType", dt):
            doctype = dt
            break

    if not doctype:
        return {}

    meta = frappe.get_meta(doctype)
    patient_fields = []

    for df in meta.fields:
        if df.fieldtype == "Link" and df.options == "Patient":
            patient_fields.append(df.fieldname)

    for fieldname in ("custom_patient", "patient", "patient_id", "custom_patient_id"):
        if meta.has_field(fieldname) and fieldname not in patient_fields:
            patient_fields.append(fieldname)

    if not patient_fields:
        return {}

    fields = ["name", "docstatus", "modified"]

    for fieldname in (
        "purpose",
        "discount_value",
        "custom_kpws_welfare_type",
        "custom_kpws_welfare_percentage",
        "custom_panel_customer",
        "custom_kpws_assigned_panel_customer",
        "custom_kpws_admin_notes",
        "remarks",
    ):
        if meta.has_field(fieldname):
            fields.append(fieldname)

    rows = []
    seen = set()

    for patient_field in patient_fields:
        try:
            found = frappe.get_all(
                doctype,
                filters={patient_field: patient},
                fields=fields,
                order_by="docstatus desc, modified desc",
                limit_page_length=10,
            )
            for row in found:
                if row.name not in seen:
                    seen.add(row.name)
                    rows.append(row)
        except Exception:
            pass

    if not rows:
        return {}

    submitted = [r for r in rows if cint(r.docstatus) == 1]
    row = submitted[0] if submitted else rows[0]

    purpose = row.get("purpose") or row.get("custom_kpws_welfare_type")
    percentage = row.get("discount_value")
    if percentage in (None, ""):
        percentage = row.get("custom_kpws_welfare_percentage")

    panel = row.get("custom_panel_customer") or row.get("custom_kpws_assigned_panel_customer")

    return {
        "doctype": doctype,
        "name": row.name,
        "docstatus": row.docstatus,
        "status": "Submitted" if cint(row.docstatus) == 1 else "Draft / Pending",
        "purpose": purpose,
        "percentage": flt(percentage),
        "panel_customer": panel,
        "admin_notes": row.get("custom_kpws_admin_notes"),
        "remarks": row.get("remarks"),
    }


def _price_for_group(settings, group):
    if group == "Panel":
        return settings.panel_price_list
    if group == "Welfare":
        return settings.welfare_price_list
    return settings.cash_price_list


def _get_item_price(item_code, price_list, posting_date=None, uom=None):
    if not item_code or not price_list:
        return 0

    posting_date = getdate(posting_date or nowdate())

    filters = {
        "item_code": item_code,
        "price_list": price_list,
        "selling": 1,
    }

    if _has_field("Item Price", "disabled"):
        filters["disabled"] = 0

    rows = frappe.get_all(
        "Item Price",
        filters=filters,
        fields=["name", "price_list_rate", "uom", "valid_from", "valid_upto"],
        order_by="valid_from desc, modified desc",
        limit_page_length=50,
    )

    for row in rows:
        if flt(row.price_list_rate) <= 0:
            continue
        if row.valid_from and getdate(row.valid_from) > posting_date:
            continue
        if row.valid_upto and getdate(row.valid_upto) < posting_date:
            continue
        if row.uom and uom and row.uom != uom:
            continue
        return flt(row.price_list_rate)

    return 0


def _available_qty(item_code, warehouse):
    if not item_code or not warehouse:
        return 0
    return flt(frappe.db.get_value("Bin", {"item_code": item_code, "warehouse": warehouse}, "actual_qty"))


def _panel_flag_field():
    meta = frappe.get_meta("Customer")
    for fieldname in ("is_panel", "custom_is_panel"):
        if meta.has_field(fieldname):
            return fieldname
    return None


def _get_patient_status(patient):
    try:
        from kpws_customization.api.kpws_patient_invoice_control import get_sales_invoice_patient_billing_status
        return get_sales_invoice_patient_billing_status(patient=patient)
    except Exception as e:
        return {
            "blocked": True,
            "group": None,
            "title": "Patient Status Check Failed",
            "message": str(e),
            "indicator": "red",
        }


@frappe.whitelist()
def get_settings():
    _require_role()
    return _settings_dict()


@frappe.whitelist()
def save_settings(values):
    _require_role()

    roles = set(frappe.get_roles())
    if not roles.intersection({"System Manager", "Accounts Manager"}):
        frappe.throw(_("Only System Manager or Accounts Manager can update Pharmacy Billing Settings."), frappe.PermissionError)

    values = _json(values)
    doc = _ensure_settings_doc()

    allowed = set(_settings_dict(doc).keys())
    for key, value in values.items():
        if key in allowed:
            doc.set(key, value)

    doc.save(ignore_permissions=True)
    frappe.db.commit()

    return _settings_dict(doc)


@frappe.whitelist()
def get_patient_context(patient):
    _require_role()

    settings = _ensure_settings_doc()

    if not patient:
        frappe.throw(_("Please select Patient."))

    if not frappe.db.exists("Patient", patient):
        frappe.throw(_("Patient not found: {0}").format(patient))

    pdoc = frappe.get_doc("Patient", patient)
    status = _get_patient_status(patient)

    group = status.get("group") or "Cash"
    registration = _latest_registration(patient)

    patient_customer = _patient_customer(pdoc)
    bill_to_customer = patient_customer

    if group == "Panel":
        bill_to_customer = status.get("panel_customer") or registration.get("panel_customer")
    elif not bill_to_customer:
        bill_to_customer = settings.default_cash_customer

    price_list = _price_for_group(settings, group)

    return {
        "patient": patient,
        "patient_name": _patient_name(pdoc),
        "mr_number": _patient_mr(pdoc),
        "patient_customer": patient_customer,
        "bill_to_customer": bill_to_customer,
        "group": group,
        "price_list": price_list,
        "status": status,
        "registration": registration,
        "settings": _settings_dict(settings),
    }


@frappe.whitelist()
def search_items(txt="", patient=None, price_list=None):
    _require_role()

    settings = _ensure_settings_doc()
    warehouse = settings.pharmacy_warehouse

    if not price_list and patient:
        ctx = get_patient_context(patient)
        price_list = ctx.get("price_list")

    txt = (txt or "").strip()

    if not warehouse:
        frappe.throw(_("Please set Pharmacy Warehouse in Settings tab."))

    rows = frappe.db.sql(
        """
        SELECT
            i.name AS item_code,
            i.item_name,
            i.stock_uom,
            IFNULL(b.actual_qty, 0) AS available_qty
        FROM `tabItem` i
        INNER JOIN `tabBin` b
            ON b.item_code = i.name
            AND b.warehouse = %(warehouse)s
        WHERE
            IFNULL(i.disabled, 0) = 0
            AND IFNULL(b.actual_qty, 0) > 0
            AND (
                i.name LIKE %(txt)s
                OR i.item_name LIKE %(txt)s
            )
        ORDER BY i.item_name ASC
        LIMIT 20
        """,
        {
            "warehouse": warehouse,
            "txt": f"%{txt}%",
        },
        as_dict=True,
    )

    for row in rows:
        row.rate = _get_item_price(
            item_code=row.item_code,
            price_list=price_list,
            posting_date=nowdate(),
            uom=row.stock_uom,
        )
        row.missing_price = 1 if flt(row.rate) <= 0 else 0
        row.warehouse = warehouse
        row.price_list = price_list

    return rows


@frappe.whitelist()
def create_invoice(payload):
    _require_role()

    payload = _json(payload)
    settings = _ensure_settings_doc()

    patient = payload.get("patient")
    items = _list(payload.get("items"))

    if not patient:
        frappe.throw(_("Please select Patient."))

    if not items:
        frappe.throw(_("Please add at least one item."))

    ctx = get_patient_context(patient)
    status = ctx.get("status") or {}

    if cint(settings.enforce_patient_status) and status.get("blocked"):
        frappe.throw(status.get("message") or _("Patient billing status is not valid."))

    group = ctx.get("group") or "Cash"
    bill_to_customer = payload.get("bill_to_customer") or ctx.get("bill_to_customer")

    if not bill_to_customer:
        frappe.throw(_("Bill To Customer is missing. Please fix Patient/Settings first."))

    if group == "Panel":
        required_panel_customer = ctx.get("bill_to_customer")
        if not required_panel_customer:
            frappe.throw(_("Panel is not assigned on this Patient."))

        if bill_to_customer != required_panel_customer:
            frappe.throw(_("For Panel patient, Bill To Customer must be the assigned Panel Customer: {0}").format(required_panel_customer))

        panel_flag = _panel_flag_field()
        if panel_flag and not cint(frappe.db.get_value("Customer", bill_to_customer, panel_flag)):
            frappe.throw(_("Selected Bill To Customer is not marked as Is Panel."))

    warehouse = settings.pharmacy_warehouse
    if not warehouse:
        frappe.throw(_("Please set Pharmacy Warehouse in Settings tab."))

    price_list = payload.get("price_list") or ctx.get("price_list")
    if not price_list:
        frappe.throw(_("Selling Price List is missing. Please update Settings tab."))

    company = settings.company or _first_company()
    if not company:
        frappe.throw(_("Default Company is missing. Please update Settings tab."))

    si = frappe.new_doc("Sales Invoice")
    si.company = company
    si.customer = bill_to_customer
    si.posting_date = nowdate()
    si.update_stock = cint(settings.update_stock)
    si.selling_price_list = price_list

    _set_if_has(si, "set_warehouse", warehouse)

    for fieldname in PATIENT_FIELDS_ON_SI:
        if _has_field("Sales Invoice", fieldname):
            si.set(fieldname, patient)
            break

    clean_items = []

    for row in items:
        item_code = row.get("item_code")
        qty = flt(row.get("qty"))

        if not item_code:
            continue

        if qty <= 0:
            frappe.throw(_("Qty must be greater than zero for item {0}").format(item_code))

        available = _available_qty(item_code, warehouse)

        if cint(settings.enforce_pharmacy_stock) and available < qty:
            frappe.throw(
                _("Insufficient stock for {0}. Available: {1}, Required: {2}").format(
                    item_code, available, qty
                )
            )

        uom = frappe.db.get_value("Item", item_code, "stock_uom")
        rate = _get_item_price(item_code, price_list, nowdate(), uom)

        if cint(settings.allow_manual_rate) and flt(row.get("rate")) > 0:
            rate = flt(row.get("rate"))

        if cint(settings.block_missing_price) and flt(rate) <= 0:
            frappe.throw(_("Missing price for item {0}. Please ask Warehouse / Accounts to update pricing.").format(item_code))

        clean_items.append({
            "item_code": item_code,
            "qty": qty,
            "rate": rate,
            "warehouse": warehouse,
        })

    if not clean_items:
        frappe.throw(_("Please add at least one valid item."))

    for row in clean_items:
        si.append("items", row)

    registration = ctx.get("registration") or {}
    percentage = flt(registration.get("percentage"))

    if cint(settings.apply_registration_percentage_as_discount) and percentage > 0:
        si.apply_discount_on = "Grand Total"
        si.additional_discount_percentage = percentage

    paid_amount = flt(payload.get("paid_amount"))
    mode_of_payment = payload.get("mode_of_payment") or settings.default_mode_of_payment

    if group == "Cash" and cint(settings.require_cash_payment) and paid_amount <= 0 and cint(settings.auto_submit_invoice):
        frappe.throw(_("Cash patient payment is required before submit."))

    if paid_amount > 0:
        si.is_pos = 1
        if not mode_of_payment:
            frappe.throw(_("Mode of Payment is required. Please update Settings tab."))
        si.append("payments", {
            "mode_of_payment": mode_of_payment,
            "amount": paid_amount,
        })

    _set_if_has(si, "custom_kpws_patient_billing_group", group)
    _set_if_has(si, "custom_kpws_prf", registration.get("name"))
    _set_if_has(si, "custom_kpws_purpose", registration.get("purpose"))
    _set_if_has(si, "custom_kpws_approved_percentage", percentage)

    si.insert(ignore_permissions=True)

    submit_now = cint(payload.get("submit")) or cint(settings.auto_submit_invoice)
    if submit_now:
        si.submit()

    return {
        "ok": True,
        "name": si.name,
        "docstatus": si.docstatus,
        "route": f"/app/sales-invoice/{si.name}",
        "print_format": settings.print_format,
        "message": "Sales Invoice created successfully.",
    }


