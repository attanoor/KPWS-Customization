def _ensure_role():
    if not frappe.db.exists("Role", "KPWS Pharmacy User"):
        frappe.get_doc({
            "doctype": "Role",
            "role_name": "KPWS Pharmacy User",
            "desk_access": 1,
        }).insert(ignore_permissions=True)


def _create_page():
    module = "KPWS Customization"
    if not frappe.db.exists("Module Def", module):
        module = frappe.db.get_value("Module Def", {"app_name": "kpws_customization"}, "name") or "Custom"

    existing = frappe.db.exists("Page", PAGE_NAME)
    if existing:
        page = frappe.get_doc("Page", existing)
    else:
        page = frappe.new_doc("Page")
        page.page_name = PAGE_NAME

    page.title = "KPWS Pharmacy Billing"
    page.module = module
    page.standard = "Yes"

    try:
        page.roles = []
        for role in ("System Manager", "Accounts Manager", "Sales User", "KPWS Pharmacy User"):
            page.append("roles", {"role": role})
    except Exception:
        pass

    page.save(ignore_permissions=True)


@frappe.whitelist()
def install():
    _ensure_role()
    _create_settings_doctype()
    _create_page()
    _ensure_settings_doc()

    frappe.clear_cache()
    frappe.db.commit()

    return {
        "ok": True,
        "page": "/app/kpws-pharmacy-billing",
        "settings_doctype": SETTINGS_DOCTYPE,
        "role": "KPWS Pharmacy User",
    }




