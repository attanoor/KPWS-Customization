        return "Panel"

    if any(m == zakat_mode or m == donation_mode or "zakat" in m or "donation" in m for m in low_modes):
        return "Welfare"

    group = original.get("custom_kpws_patient_billing_group")
    if group in ("Cash", "Welfare", "Panel"):
        return group

    return "Cash"


