def _kpws_v72_get_patient_type_from_invoice(doc):
    import frappe

    patient = (
        doc.get("patient")
        or doc.get("custom_patient")
        or doc.get("custom_kpws_patient")
    )

    if patient and frappe.db.exists("Patient", patient):
        return frappe.db.get_value("Patient", patient, "customer_group")

    # fallback custom marker
    for fieldname in [
        "custom_kpws_patient_billing_group",
        "custom_patient_billing_group",
        "custom_billing_group",
    ]:
        if doc.meta.has_field(fieldname) and doc.get(fieldname):
            return doc.get(fieldname)

    # fallback from customer
    if doc.get("customer") and frappe.db.exists("Customer", doc.customer):
        return frappe.db.get_value("Customer", doc.customer, "customer_group")

    return None


def _kpws_v72_get_patient_customer_from_invoice(doc):
    import frappe

    patient = (
        doc.get("patient")
        or doc.get("custom_patient")
        or doc.get("custom_kpws_patient")
    )

    if patient and frappe.db.exists("Patient", patient):
        return frappe.db.get_value("Patient", patient, "customer")

    return None


def _kpws_v72_customer_receivable(customer, company):
    import frappe

    company = company or "Kiran Patient Welfare Society"

    if customer and frappe.db.exists("Customer", customer):
        try:
            c = frappe.get_doc("Customer", customer)
            for row in c.get("accounts") or []:
                if row.company == company and row.account:
                    return row.account
        except Exception:
            pass

    return (
        frappe.db.get_value("Company", company, "default_receivable_account")
        or frappe.db.get_value(
            "Account",
            {
                "company": company,
                "account_type": "Receivable",
                "is_group": 0,
            },
            "name",
        )
    )


def validate_sales_invoice_patient_billing_rules(doc, method=None):
    """
    Final validator override.

    Personal Advance is a valid patient type.
    It must not be blocked by old Cash/Welfare/Panel-only logic.
    """
    import frappe

    patient_type = _kpws_v72_get_patient_type_from_invoice(doc)

    # Normalize
    patient_type = (patient_type or "").strip()

    if patient_type == "Personal Advance":
        customer = _kpws_v72_get_patient_customer_from_invoice(doc)

        if not customer or not frappe.db.exists("Customer", customer):
            frappe.throw(
                "Personal Advance patient must have a linked Customer before billing. "
                "Please receive Personal Advance from Accounts first."
            )

        # Force the correct customer and non-POS behavior.
        doc.customer = customer
        doc.customer_name = frappe.db.get_value("Customer", customer, "customer_name") or customer

        receivable = _kpws_v72_customer_receivable(customer, doc.get("company"))
        if receivable:
            doc.debit_to = receivable

        doc.is_pos = 0
        doc.pos_profile = None
        doc.set("payments", [])

        for fieldname in [
            "paid_amount",
            "base_paid_amount",
            "change_amount",
            "base_change_amount",
            "write_off_amount",
            "base_write_off_amount",
        ]:
            if doc.meta.has_field(fieldname):
                doc.set(fieldname, 0)

        if doc.meta.has_field("custom_kpws_patient_billing_group"):
            doc.custom_kpws_patient_billing_group = "Personal Advance"

        return

    # For normal old types, keep old validator.
    if _kpws_original_validate_sales_invoice_patient_billing_rules:
        return _kpws_original_validate_sales_invoice_patient_billing_rules(doc, method)

    return
