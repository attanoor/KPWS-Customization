# KPWS_PATIENT_INTAKE_CREATE_PANEL_CUSTOMER_V59
@frappe.whitelist()
def create_panel_customer(panel_name=None):
    """
    Quick-create Panel Customer from Patient Intake.

    Minimum input:
      - Panel Name

    Background defaults:
      - Customer Type = Company
      - Customer Group = Panel
      - Territory = Pakistan
      - custom_is_panel = 1
      - Account row linked to PANEL RECEIVABLE CONTROL - KPWS if account exists
    """
    import frappe
    import re

    panel_name = (panel_name or "").strip()

    if not panel_name:
        frappe.throw("Panel Name is required.")

    panel_name = re.sub(r"\s+", " ", panel_name).strip()

    if len(panel_name) < 2:
        frappe.throw("Panel Name is too short.")

    # Duplicate validation by Customer ID and Customer Name
    if frappe.db.exists("Customer", panel_name):
        frappe.throw("A Customer already exists with this Panel Name: {0}".format(panel_name))

    duplicate = frappe.db.sql("""
        SELECT name, customer_name
        FROM `tabCustomer`
        WHERE LOWER(TRIM(customer_name)) = LOWER(TRIM(%s))
        LIMIT 1
    """, panel_name, as_dict=True)

    if duplicate:
        frappe.throw(
            "A Customer already exists with similar Panel Name: {0}".format(
                duplicate[0].name
            )
        )

    customer_group = "Panel"
    if not frappe.db.exists("Customer Group", customer_group):
        frappe.throw("Customer Group 'Panel' does not exist. Please create it first.")

    territory = "Pakistan"
    if not frappe.db.exists("Territory", territory):
        root = "All Territories"
        if not frappe.db.exists("Territory", root):
            root = frappe.db.get_value("Territory", {"is_group": 1}, "name")

        terr = frappe.new_doc("Territory")
        terr.territory_name = territory
        terr.parent_territory = root
        terr.is_group = 0
        terr.insert(ignore_permissions=True)

    doc = frappe.new_doc("Customer")
    doc.customer_name = panel_name
    doc.customer_type = "Company"
    doc.customer_group = customer_group
    doc.territory = territory

    if doc.meta.has_field("custom_is_panel"):
        doc.custom_is_panel = 1

    if doc.meta.has_field("disabled"):
        doc.disabled = 0

    # Link generic panel receivable account if available.
    company = "Kiran Patient Welfare Society"
    panel_receivable = "PANEL RECEIVABLE CONTROL - KPWS"

    if frappe.db.exists("Account", panel_receivable):
        acc = frappe.db.get_value(
            "Account",
            panel_receivable,
            ["company", "is_group", "account_type"],
            as_dict=True,
        )

        if acc and acc.company == company and not int(acc.is_group or 0):
            doc.append("accounts", {
                "company": company,
                "account": panel_receivable,
            })

    doc.insert(ignore_permissions=True)
    frappe.db.commit()

    return {
        "ok": True,
        "customer": doc.name,
        "customer_name": doc.customer_name,
        "label": doc.customer_name,
        "value": doc.name,
    }


# KPWS_PATIENT_INTAKE_NO_CUSTOMER_ON_UPDATE_V62
@frappe.whitelist()
def save_patient(payload=None, data=None, **kwargs):
    """
    Final Patient Intake save.

    Important rule:
    - New Patient: create Patient normally.
    - Existing Patient: DO NOT call doc.save(), because Healthcare Patient hooks
      can create/update Customer/Contact in background.
    - Existing Patient updates are done with frappe.db.set_value only.
    """
    import json
    import frappe
    from frappe.utils import cint

    def parse_any(value):
        if not value:
            return {}
        if isinstance(value, dict):
            return dict(value)
        if isinstance(value, str):
            try:
                return json.loads(value)
            except Exception:
                return {}
        try:
            return dict(value)
        except Exception:
            return {}

    raw = {}
    raw.update(parse_any(payload))
    raw.update(parse_any(data))
    raw.update(parse_any(kwargs))

    for k, v in dict(frappe.form_dict).items():
        if k == "cmd":
            continue
        if k in ("payload", "data") and isinstance(v, str):
            raw.update(parse_any(v))
        else:
            raw[k] = v

    if isinstance(raw.get("patient"), dict):
        nested = dict(raw.get("patient"))
        nested.update({k: v for k, v in raw.items() if k != "patient"})
        raw = nested

    lower = {str(k).lower(): v for k, v in raw.items()}

    def pick(*keys):
        for key in keys:
            if key in raw and raw.get(key) not in (None, ""):
                return raw.get(key)
            lk = str(key).lower()
            if lk in lower and lower.get(lk) not in (None, ""):
                return lower.get(lk)
        return None

    def has_patient_field(fieldname):
        return frappe.get_meta("Patient").has_field(fieldname)

    def normalize_cnic(value):
        return "".join(ch for ch in str(value or "") if ch.isdigit())

    patient_name = pick("name", "patient", "patient_id", "patient_docname")
    existing_patient = patient_name if patient_name and frappe.db.exists("Patient", patient_name) else None

    first_name = pick("first_name", "firstname", "patient_first_name")
    last_name = pick("last_name", "lastname", "patient_last_name")
    full_name = pick("patient_name", "full_name", "name_text")

    if not first_name and full_name:
        parts = str(full_name).strip().split()
        if parts:
            first_name = parts[0]
            if not last_name and len(parts) > 1:
                last_name = " ".join(parts[1:])

    age_value = pick("age_", "age", "patient_age", "custom_age")
    gender_value = pick("sex", "gender", "patient_gender")
    mobile_value = pick("mobile", "mobile_no", "phone", "contact", "custom_kpws_mobile_no")
    cnic_value = pick("cnic", "cnic_number", "custom_kpws_cnic", "custom_cnic", "custom_cnic_number")
    mr_number = pick("custom_reference_number", "mr_number", "kiran_mr_number", "mr_no")
    old_kpws = pick("custom_old_kpws_number", "old_kpws_number", "old_kpws_no")
    patient_status = pick("patient_status", "status") or "SE"
    patient_type = pick("customer_group", "patient_type", "billing_type", "custom_billing_type") or "Cash"
    funding_source = pick("custom_kpws_funding_source", "funding_source")
    panel_customer = pick("custom_panel_customer", "panel_customer", "custom_kpws_panel_customer")
    details = pick("patient_details", "notes", "remarks", "address")

    allowed_types = ("Cash", "Welfare", "Panel", "Personal Advance")
    if patient_type not in allowed_types:
        frappe.throw("Patient Type must be Cash, Welfare, Panel, or Personal Advance.")

    if patient_type in ("Cash", "Personal Advance"):
        funding_source = ""
        panel_customer = ""

    if patient_type == "Panel":
        funding_source = ""
        if not panel_customer:
            frappe.throw("Panel Name is required for Panel patient.")

    if patient_type == "Welfare":
        if funding_source not in ("Zakat", "Donation", "Panel"):
            frappe.throw("Funding Source is required for Welfare patient.")
        if funding_source == "Panel" and not panel_customer:
            frappe.throw("Panel Name is required when Welfare Funding Source is Panel.")

    if not first_name:
        frappe.throw("First Name is required.")

    if not cnic_value:
        frappe.throw("CNIC is required.")

    if not age_value:
        frappe.throw("Age is required.")

    # Duplicate CNIC check
    cnic_norm = normalize_cnic(cnic_value)
    cnic_fields = [
        "custom_kpws_cnic",
        "cnic",
        "cnic_number",
        "custom_cnic",
        "custom_cnic_number",
    ]

    for fieldname in cnic_fields:
        if not has_patient_field(fieldname):
            continue

        rows = frappe.get_all(
            "Patient",
            filters={fieldname: ["is", "set"]},
            fields=["name", fieldname],
            limit=1000,
        )

        for row in rows:
            if existing_patient and row.name == existing_patient:
                continue

            existing_norm = normalize_cnic(row.get(fieldname))
            if cnic_norm and existing_norm and cnic_norm == existing_norm:
                frappe.throw(
                    "Patient already exists with this CNIC: {0}. Existing Patient: {1}".format(
                        cnic_value,
                        row.name,
                    )
                )

    # Fields to update
    updates = {}

    def add(fieldname, value, allow_blank=False):
        if not has_patient_field(fieldname):
            return
        if value in (None, "") and not allow_blank:
            return
        updates[fieldname] = value

    add("first_name", first_name)
    add("last_name", last_name, allow_blank=True)
    add("age_", age_value)
    add("age", age_value)
    add("sex", gender_value, allow_blank=True)
    add("gender", gender_value, allow_blank=True)
    add("mobile", mobile_value, allow_blank=True)
    add("mobile_no", mobile_value, allow_blank=True)
    add("phone", mobile_value, allow_blank=True)
    add("custom_kpws_mobile_no", mobile_value, allow_blank=True)
    add("custom_kpws_cnic", cnic_value)
    add("cnic", cnic_value)
    add("cnic_number", cnic_value)
    add("custom_cnic", cnic_value)
    add("custom_cnic_number", cnic_value)
    add("custom_reference_number", mr_number, allow_blank=True)
    add("custom_old_kpws_number", old_kpws, allow_blank=True)
    add("patient_status", patient_status)
    add("customer_group", patient_type)
    add("custom_kpws_funding_source", funding_source, allow_blank=True)
    add("custom_panel_customer", panel_customer, allow_blank=True)
    add("custom_kpws_panel_customer", panel_customer, allow_blank=True)
    add("patient_details", details, allow_blank=True)

    if existing_patient:
        # Critical fix:
        # Direct DB update only. This avoids Healthcare Patient hooks that create/update Customer.
        frappe.db.set_value("Patient", existing_patient, updates, update_modified=True)
        frappe.db.commit()

        doc = frappe.get_doc("Patient", existing_patient)

        return {
            "ok": True,
            "mode": "updated_without_customer_sync",
            "patient": doc.name,
            "name": doc.name,
            "patient_name": doc.get("patient_name") or " ".join([
                str(doc.get("first_name") or ""),
                str(doc.get("last_name") or ""),
            ]).strip(),
            "customer": doc.get("customer"),
            "customer_group": doc.get("customer_group"),
            "funding_source": doc.get("custom_kpws_funding_source"),
            "panel_customer": doc.get("custom_panel_customer"),
        }

    # New patient: create once.
    doc = frappe.new_doc("Patient")

    for fieldname, value in updates.items():
        if doc.meta.has_field(fieldname):
            doc.set(fieldname, value)

    # Friendly mandatory validation
    missing = []
    for df in doc.meta.fields:
        if cint(df.reqd) and not doc.get(df.fieldname):
            missing.append(df.label or df.fieldname)

    if missing:
        frappe.throw("Please fill mandatory Patient fields: " + ", ".join(missing))

    # New Patient may run Healthcare standard creation once.
    # Updates after this will not create new customers.
    doc.insert(ignore_permissions=True)
    frappe.db.commit()

    return {
        "ok": True,
        "mode": "created",
        "patient": doc.name,
        "name": doc.name,
        "patient_name": doc.get("patient_name") or " ".join([
            str(doc.get("first_name") or ""),
            str(doc.get("last_name") or ""),
        ]).strip(),
        "customer": doc.get("customer"),
        "customer_group": doc.get("customer_group"),
        "funding_source": doc.get("custom_kpws_funding_source"),
        "panel_customer": doc.get("custom_panel_customer"),
    }


# KPWS_PATIENT_CONTEXT_CURRENT_TYPE_ONLY_V63
@frappe.whitelist()
def get_patient_context(patient=None):
    """
    Return context based on CURRENT Patient Type only.

    Important:
    If Patient Type is Cash / Panel / Personal Advance, do not show old Welfare Registration
    on Patient Intake screen. Old PRFs remain in database for audit only.
    """
    import frappe

    if not patient or not frappe.db.exists("Patient", patient):
        frappe.throw("Patient not found.")

    p = frappe.get_doc("Patient", patient)

    patient_type = p.get("customer_group") or "Cash"

    ctx = {
        "patient": p.name,
        "patient_name": (
            p.get("patient_name")
            or " ".join([str(p.get("first_name") or ""), str(p.get("last_name") or "")]).strip()
            or p.name
        ),
        "mr_number": p.get("custom_reference_number"),
        "patient_type": patient_type,
        "funding_source": p.get("custom_kpws_funding_source"),
        "panel_customer": p.get("custom_panel_customer"),
        "customer": p.get("customer"),
        "welfare_registration": None,
        "welfare_not_required": patient_type != "Welfare",
        "latest_token": None,
    }

    # Latest token should still show for all patient types.
    if frappe.db.exists("DocType", "Patient Token"):
        try:
            token_meta = frappe.get_meta("Patient Token")
            patient_field = None
            for f in ["patient", "custom_patient", "patient_id", "custom_patient_id"]:
                if token_meta.has_field(f):
                    patient_field = f
                    break

            if patient_field:
                rows = frappe.get_all(
                    "Patient Token",
                    filters={patient_field: p.name},
                    fields=["name", "creation"],
                    order_by="creation desc",
                    limit=1,
                )
                if rows:
                    ctx["latest_token"] = {
                        "name": rows[0].name,
                        "created": str(rows[0].creation),
                    }
        except Exception:
            pass

    # Only show Welfare Registration when current Patient Type is Welfare.
    if patient_type != "Welfare":
        return ctx

    if frappe.db.exists("DocType", "Patient Registration Form"):
        prf_meta = frappe.get_meta("Patient Registration Form")

        filters = {}
        if prf_meta.has_field("custom_patient"):
            filters["custom_patient"] = p.name
        elif prf_meta.has_field("patient"):
            filters["patient"] = p.name

        if filters:
            rows = frappe.get_all(
                "Patient Registration Form",
                filters=filters,
                fields=["name", "docstatus", "workflow_state", "modified"],
                order_by="modified desc",
                limit=1,
            )

            if rows:
                prf = frappe.get_doc("Patient Registration Form", rows[0].name)
                ctx["welfare_registration"] = {
                    "name": prf.name,
                    "docstatus": prf.docstatus,
                    "workflow_state": prf.get("workflow_state"),
                    "purpose": prf.get("custom_kpws_welfare_type") or prf.get("purpose"),
                    "percentage": prf.get("custom_kpws_welfare_percentage") or prf.get("discount_value"),
                    "panel_customer": prf.get("custom_panel_customer"),
                    "modified": str(prf.modified),
                }

    return ctx
