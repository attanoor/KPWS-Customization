def _kpws_v52_normalize_payload_dict(value):
    import json
    import frappe

    if value is None:
        return {}

    if isinstance(value, dict):
        return frappe._dict(value)

    if isinstance(value, str):
        try:
            return frappe._dict(json.loads(value))
        except Exception:
            return frappe._dict({})

    try:
        return frappe._dict(value)
    except Exception:
        return frappe._dict({})


def _kpws_v52_set_if_has_field(doc, fieldname, value):
    if value is None:
        return

    if value == "":
        return

    try:
        if doc.meta.has_field(fieldname):
            doc.set(fieldname, value)
    except Exception:
        pass


def _kpws_v52_prepare_patient_before_save(doc, raw_payload=None):
    """
    Final safety mapping before saving Patient from KPWS Patient Intake.

    Fixes:
      MandatoryError: age_

    Reason:
      Patient doctype has required field age_, but the intake UI may send it
      as age / patient_age / custom_age. This maps it safely.
    """
    import frappe

    if not doc or getattr(doc, "doctype", None) != "Patient":
        return doc

    data = _kpws_v52_normalize_payload_dict(raw_payload)

    def pick(*keys):
        for key in keys:
            value = data.get(key)
            if value not in (None, ""):
                return value
        return None

    # Name fields
    _kpws_v52_set_if_has_field(doc, "first_name", pick("first_name", "patient_first_name"))
    _kpws_v52_set_if_has_field(doc, "last_name", pick("last_name", "patient_last_name"))

    # If first_name is still missing but patient_name/full_name was sent, split it.
    full_name = pick("patient_name", "full_name", "name_text")
    if full_name and doc.meta.has_field("first_name") and not doc.get("first_name"):
        parts = str(full_name).strip().split()
        if parts:
            doc.first_name = parts[0]
            if doc.meta.has_field("last_name") and len(parts) > 1:
                doc.last_name = " ".join(parts[1:])

    # Age field. Your Patient doctype mandatory field is age_.
    age_value = pick("age_", "age", "patient_age", "custom_age")
    if age_value not in (None, ""):
        _kpws_v52_set_if_has_field(doc, "age_", age_value)
        _kpws_v52_set_if_has_field(doc, "age", age_value)

    # Gender/Sex. Healthcare Patient usually uses sex.
    gender_value = pick("sex", "gender", "patient_gender")
    if gender_value:
        _kpws_v52_set_if_has_field(doc, "sex", gender_value)
        _kpws_v52_set_if_has_field(doc, "gender", gender_value)

    # Mobile
    mobile_value = pick("mobile", "mobile_no", "phone", "contact", "custom_kpws_mobile_no")
    if mobile_value:
        _kpws_v52_set_if_has_field(doc, "mobile", mobile_value)
        _kpws_v52_set_if_has_field(doc, "mobile_no", mobile_value)
        _kpws_v52_set_if_has_field(doc, "phone", mobile_value)
        _kpws_v52_set_if_has_field(doc, "custom_kpws_mobile_no", mobile_value)

    # CNIC
    cnic_value = pick("cnic", "cnic_number", "custom_kpws_cnic", "custom_cnic")
    if cnic_value:
        _kpws_v52_set_if_has_field(doc, "custom_kpws_cnic", cnic_value)
        _kpws_v52_set_if_has_field(doc, "cnic", cnic_value)
        _kpws_v52_set_if_has_field(doc, "cnic_number", cnic_value)

    # MR numbers
    _kpws_v52_set_if_has_field(doc, "custom_reference_number", pick("custom_reference_number", "mr_number", "kiran_mr_number"))
    _kpws_v52_set_if_has_field(doc, "custom_old_kpws_number", pick("custom_old_kpws_number", "old_kpws_number"))

    # Patient status
    status_value = pick("patient_status", "status")
    if status_value:
        _kpws_v52_set_if_has_field(doc, "patient_status", status_value)
        _kpws_v52_set_if_has_field(doc, "status", "Active" if status_value in ("SE", "E", "NE", "P") else status_value)

    # Patient Type is customer_group in your system.
    patient_type = pick("customer_group", "patient_type", "billing_type", "custom_billing_type")
    if patient_type:
        _kpws_v52_set_if_has_field(doc, "customer_group", patient_type)

    # Funding source and panel customer
    _kpws_v52_set_if_has_field(doc, "custom_kpws_funding_source", pick("custom_kpws_funding_source", "funding_source"))
    _kpws_v52_set_if_has_field(doc, "custom_panel_customer", pick("custom_panel_customer", "panel_customer"))

    # Patient details / relation notes
    _kpws_v52_set_if_has_field(doc, "patient_details", pick("patient_details", "notes", "remarks"))
    _kpws_v52_set_if_has_field(doc, "custom_relation_name", pick("relation_name", "son_of_daughter_of_wife_of", "guardian_name"))

    # Final friendly validation for mandatory Patient fields.
    missing = []
    for df in doc.meta.fields:
        if df.reqd and not doc.get(df.fieldname):
            missing.append(df.label or df.fieldname)

    if missing:
        frappe.throw("Please fill mandatory Patient fields: " + ", ".join(missing))

    return doc



# KPWS_PATIENT_INTAKE_V52_FINAL_SAVE_PATIENT_OVERRIDE
@frappe.whitelist()
def save_patient(payload=None, data=None, **kwargs):
    """
    Final override for KPWS Patient Intake Desk.

    Fixes:
      MandatoryError: [Patient]: age_

    It accepts any of these payload styles:
      - payload JSON
      - data JSON
      - direct form_dict fields
      - nested {"patient": {...}}
    """
    import json
    import frappe
    from frappe.utils import cint

    def parse_any(value):
        if not value:
            return {}
        if isinstance(value, dict):
            return dict(value)
        if isinstance(value, str):
            try:
                return json.loads(value)
            except Exception:
                return {}
        try:
            return dict(value)
        except Exception:
            return {}

    raw = {}

    # 1. JSON payload/data
    raw.update(parse_any(payload))
    raw.update(parse_any(data))

    # 2. kwargs
    raw.update(parse_any(kwargs))

    # 3. frappe.form_dict
    for k, v in dict(frappe.form_dict).items():
        if k in ("cmd",):
            continue

        if k in ("payload", "data") and isinstance(v, str):
            raw.update(parse_any(v))
        else:
            raw[k] = v

    # 4. nested patient object
    if isinstance(raw.get("patient"), dict):
        nested = dict(raw.get("patient"))
        nested.update({k: v for k, v in raw.items() if k != "patient"})
        raw = nested

    # Case-insensitive access
    lower = {}
    for k, v in raw.items():
        lower[str(k).lower()] = v

    def pick(*keys):
        for key in keys:
            if key in raw and raw.get(key) not in (None, ""):
                return raw.get(key)
            lk = str(key).lower()
            if lk in lower and lower.get(lk) not in (None, ""):
                return lower.get(lk)
        return None

    def has_field(doc, fieldname):
        try:
            return doc.meta.has_field(fieldname)
        except Exception:
            return False

    def set_if_exists(doc, fieldname, value, allow_blank=False):
        if value in (None, "") and not allow_blank:
            return
        if has_field(doc, fieldname):
            doc.set(fieldname, value)

    patient_name = pick("name", "patient_id", "patient_name_id", "patient_docname")

    if patient_name and frappe.db.exists("Patient", patient_name):
        doc = frappe.get_doc("Patient", patient_name)
    else:
        doc = frappe.new_doc("Patient")

    # Naming series
    naming_series = pick("naming_series", "series")
    if naming_series and has_field(doc, "naming_series"):
        doc.naming_series = naming_series

    # Names
    first_name = pick("first_name", "firstname", "patient_first_name")
    last_name = pick("last_name", "lastname", "patient_last_name")
    full_name = pick("patient_name", "full_name", "name_text", "fullName")

    if not first_name and full_name:
        parts = str(full_name).strip().split()
        if parts:
            first_name = parts[0]
            if not last_name and len(parts) > 1:
                last_name = " ".join(parts[1:])

    set_if_exists(doc, "first_name", first_name)
    set_if_exists(doc, "last_name", last_name)

    # Age - your Patient doctype mandatory field is age_
    age_value = pick("age_", "age", "patient_age", "custom_age")
    set_if_exists(doc, "age_", age_value)
    set_if_exists(doc, "age", age_value)

    # Gender / Sex
    gender_value = pick("sex", "gender", "patient_gender")
    set_if_exists(doc, "sex", gender_value)
    set_if_exists(doc, "gender", gender_value)

    # Patient status / active status
    patient_status = pick("patient_status")
    if not patient_status:
        patient_status = "SE"

    set_if_exists(doc, "patient_status", patient_status)

    if has_field(doc, "status") and not doc.get("status"):
        doc.status = "Active"

    # CNIC fields
    cnic_value = pick(
        "cnic",
        "cnic_number",
        "custom_kpws_cnic",
        "custom_cnic",
        "custom_cnic_number"
    )

    set_if_exists(doc, "custom_kpws_cnic", cnic_value)
    set_if_exists(doc, "cnic", cnic_value)
    set_if_exists(doc, "cnic_number", cnic_value)
    set_if_exists(doc, "custom_cnic", cnic_value)
    set_if_exists(doc, "custom_cnic_number", cnic_value)

    # MR / old KPWS no
    set_if_exists(doc, "custom_reference_number", pick("custom_reference_number", "mr_number", "kiran_mr_number", "mr_no"))
    set_if_exists(doc, "custom_old_kpws_number", pick("custom_old_kpws_number", "old_kpws_number", "old_kpws_no"))

    # Mobile
    mobile_value = pick("mobile", "mobile_no", "phone", "contact", "custom_kpws_mobile_no")
    set_if_exists(doc, "mobile", mobile_value)
    set_if_exists(doc, "mobile_no", mobile_value)
    set_if_exists(doc, "phone", mobile_value)
    set_if_exists(doc, "custom_kpws_mobile_no", mobile_value)

    # Relation / guardian
    relation_value = pick("relation_name", "son_of_daughter_of_wife_of", "guardian_name", "father_name")
    set_if_exists(doc, "custom_relation_name", relation_value)
    set_if_exists(doc, "relation_name", relation_value)

    # Patient Type uses Customer Group in your setup
    patient_type = pick("customer_group", "patient_type", "billing_type", "custom_billing_type")
    if patient_type:
        set_if_exists(doc, "customer_group", patient_type)

    # Funding source and panel
    funding_source = pick("custom_kpws_funding_source", "funding_source")
    panel_customer = pick("custom_panel_customer", "panel_customer", "custom_kpws_panel_customer")

    set_if_exists(doc, "custom_kpws_funding_source", funding_source)
    set_if_exists(doc, "custom_panel_customer", panel_customer)
    set_if_exists(doc, "custom_kpws_panel_customer", panel_customer)

    # Notes
    set_if_exists(doc, "patient_details", pick("patient_details", "notes", "remarks", "address"))

    # Friendly mandatory validation before ERPNext raw error
    missing = []

    for df in doc.meta.fields:
        if not cint(df.reqd):
            continue

        value = doc.get(df.fieldname)

        if value in (None, "", []):
            missing.append(df.label or df.fieldname)

    if missing:
        frappe.throw("Please fill mandatory Patient fields: " + ", ".join(missing))

    # Duplicate CNIC check against all possible CNIC fields that exist
    if cnic_value:
        normalized_cnic = "".join(ch for ch in str(cnic_value) if ch.isdigit())

        cnic_fields = [
            "custom_kpws_cnic",
            "cnic",
            "cnic_number",
            "custom_cnic",
            "custom_cnic_number",
        ]

        for fieldname in cnic_fields:
            if not has_field(doc, fieldname):
                continue

            rows = frappe.get_all(
                "Patient",
                filters={fieldname: ["is", "set"]},
                fields=["name", fieldname],
                limit=500,
            )

            for row in rows:
                if row.name == doc.name:
                    continue

                existing_value = row.get(fieldname)
                existing_norm = "".join(ch for ch in str(existing_value or "") if ch.isdigit())

                if normalized_cnic and existing_norm and normalized_cnic == existing_norm:
                    frappe.throw(
                        "Patient already exists with this CNIC: {0}. Existing Patient: {1}".format(
                            cnic_value,
                            row.name,
                        )
                    )

    _kpws_v52_safe_save_patient_doc(doc)
    frappe.db.commit()

    return {
        "ok": True,
        "patient": doc.name,
        "name": doc.name,
        "patient_name": doc.get("patient_name") or " ".join(
            [str(doc.get("first_name") or ""), str(doc.get("last_name") or "")]
        ).strip(),
        "customer_group": doc.get("customer_group"),
        "funding_source": doc.get("custom_kpws_funding_source"),
        "panel_customer": doc.get("custom_panel_customer"),
    }


# KPWS_PATIENT_INTAKE_V52_CONTACT_PRIMARY_PHONE_FIX
def cleanup_contact_primary_phones():
    """
    Fix Contact records where more than one phone row is marked primary.
    Healthcare Patient save calls contact.set_primary("phone"),
    which fails if Contact already has multiple primary phone rows.
    """
    import frappe

    if not frappe.db.exists("DocType", "Contact Phone"):
        return {"fixed_contacts": 0, "fixed_rows": 0}

    has_primary_phone = frappe.db.has_column("Contact Phone", "is_primary_phone")
    has_primary_mobile = frappe.db.has_column("Contact Phone", "is_primary_mobile_no")

    fixed_contacts = 0
    fixed_rows = 0

    if has_primary_phone:
        parents = frappe.db.sql("""
            SELECT parent
            FROM `tabContact Phone`
            WHERE IFNULL(is_primary_phone, 0)=1
            GROUP BY parent
            HAVING COUNT(*) > 1
        """, as_dict=True)

        for p in parents:
            rows = frappe.get_all(
                "Contact Phone",
                filters={"parent": p.parent, "is_primary_phone": 1},
                fields=["name", "idx"],
                order_by="idx asc, creation asc"
            )

            keep = rows[0].name if rows else None

            for r in rows:
                if r.name == keep:
                    continue
                frappe.db.set_value("Contact Phone", r.name, "is_primary_phone", 0, update_modified=False)
                fixed_rows += 1

            fixed_contacts += 1

    if has_primary_mobile:
        parents = frappe.db.sql("""
            SELECT parent
            FROM `tabContact Phone`
            WHERE IFNULL(is_primary_mobile_no, 0)=1
            GROUP BY parent
            HAVING COUNT(*) > 1
        """, as_dict=True)

        for p in parents:
            rows = frappe.get_all(
                "Contact Phone",
                filters={"parent": p.parent, "is_primary_mobile_no": 1},
                fields=["name", "idx"],
                order_by="idx asc, creation asc"
            )

            keep = rows[0].name if rows else None

            for r in rows:
                if r.name == keep:
                    continue
                frappe.db.set_value("Contact Phone", r.name, "is_primary_mobile_no", 0, update_modified=False)
                fixed_rows += 1

            fixed_contacts += 1

    frappe.db.commit()

    return {
        "fixed_contacts": fixed_contacts,
        "fixed_rows": fixed_rows,
    }


def _kpws_v52_safe_save_patient_doc(doc):
    """
    Save Patient and retry once after fixing Contact primary phone conflicts.
    """
    import frappe

    try:
        doc.save(ignore_permissions=True)
        return

    except Exception as e:
        msg = str(e)

        if "Only one" in msg and "Phone" in msg and "primary" in msg:
            cleanup_contact_primary_phones()
            doc.save(ignore_permissions=True)
            return

        raise


