@frappe.whitelist()
def create_token(patient=None):
    import frappe
    from frappe.utils import nowdate, now_datetime

    p = _kpws_v54_get_patient_doc(patient)

    dt = "Patient Token"
    if not frappe.db.exists("DocType", dt):
        frappe.throw("Patient Token doctype not found.")

    doc = frappe.new_doc(dt)
    meta = frappe.get_meta(dt)

    # Patient mapping
    for f in ["patient", "custom_patient", "patient_id", "custom_patient_id"]:
        if meta.has_field(f):
            doc.set(f, p.name)
            break

    # Patient name / MR
    for f in ["patient_name", "custom_patient_name", "patient_full_name"]:
        if meta.has_field(f):
            doc.set(f, _kpws_v54_patient_display_name(p))

    for f in ["mr_number", "custom_mr_number", "mr_no", "custom_reference_number"]:
        if meta.has_field(f):
            doc.set(f, p.get("custom_reference_number"))

    # Dates
    for f in ["posting_date", "token_date", "date"]:
        if meta.has_field(f):
            doc.set(f, nowdate())

    for f in ["posting_datetime", "token_datetime", "datetime"]:
        if meta.has_field(f):
            doc.set(f, now_datetime())

    # Status defaults
    for f in ["status", "token_status"]:
        if meta.has_field(f):
            options = meta.get_field(f).options or ""
            if "Waiting" in options:
                doc.set(f, "Waiting")
            elif "Open" in options:
                doc.set(f, "Open")
            elif "Pending" in options:
                doc.set(f, "Pending")

    # Fill simple mandatory fields if still empty
    missing = []
    for df in meta.fields:
        if not df.reqd or doc.get(df.fieldname):
            continue

        if df.fieldtype == "Date":
            doc.set(df.fieldname, nowdate())
        elif df.fieldtype == "Datetime":
            doc.set(df.fieldname, now_datetime())
        elif df.fieldtype == "Link" and df.options == "Patient":
            doc.set(df.fieldname, p.name)
        elif df.fieldtype == "Link" and df.options == "Customer" and p.get("customer"):
            doc.set(df.fieldname, p.get("customer"))
        elif df.fieldtype in ("Data", "Small Text", "Text"):
            doc.set(df.fieldname, _kpws_v54_patient_display_name(p))
        elif df.fieldtype in ("Int", "Float", "Currency"):
            doc.set(df.fieldname, 0)
        elif df.fieldtype == "Select":
            opts = [x for x in (df.options or "").split("\n") if x]
            if opts:
                doc.set(df.fieldname, opts[0])

        if not doc.get(df.fieldname):
            missing.append(df.label or df.fieldname)

    if missing:
        frappe.throw("Cannot create Patient Token. Missing mandatory fields: " + ", ".join(missing))

    doc.insert(ignore_permissions=True)
    frappe.db.commit()

    return {
        "ok": True,
        "token": doc.name,
        "context": get_patient_context(p.name),
    }


# KPWS_PATIENT_INTAKE_PRF_WORKFLOW_FIX_V55
@frappe.whitelist()
def create_or_update_registration(patient=None, funding_source=None, percentage=None, panel_customer=None):
    """
    Create/Update Patient Registration Form from Patient Intake screen.

    Important:
    Do NOT set workflow_state='Pending Approval' before doc.save(),
    because Frappe Workflow blocks direct transition from Draft to Pending Approval.

    Flow:
      1. Save PRF as draft with all patient data.
      2. After save, set workflow_state to Pending Approval using db_set/db update.
      3. Keep screen on same page and return latest context.
    """
    import frappe
    from frappe.utils import flt, now_datetime

    def meta_has(dt, fieldname):
        return frappe.get_meta(dt).has_field(fieldname)

    def set_if_has(doc, fieldname, value, allow_blank=False):
        if value in (None, "") and not allow_blank:
            return
        if doc.meta.has_field(fieldname):
            doc.set(fieldname, value)

    if not patient or not frappe.db.exists("Patient", patient):
        frappe.throw("Please save/select a valid Patient first.")

    p = frappe.get_doc("Patient", patient)

    patient_type = p.get("customer_group")
    funding_source = funding_source or p.get("custom_kpws_funding_source")
    panel_customer = panel_customer or p.get("custom_panel_customer")
    percentage = flt(percentage or 100)

    if patient_type != "Welfare":
        frappe.throw("Welfare Registration can only be sent when Patient Type is Welfare.")

    if funding_source not in ("Zakat", "Donation", "Panel"):
        frappe.throw("Please select Funding Source: Zakat, Donation, or Panel.")

    if funding_source == "Panel" and not panel_customer:
        frappe.throw("Panel Name is required when Funding Source is Panel.")

    if funding_source in ("Zakat", "Donation") and percentage <= 0:
        frappe.throw("Approved Percentage is required for Zakat/Donation.")

    dt = "Patient Registration Form"
    if not frappe.db.exists("DocType", dt):
        frappe.throw("Patient Registration Form doctype not found.")

    meta = frappe.get_meta(dt)

    filters = {}
    if meta.has_field("custom_patient"):
        filters["custom_patient"] = patient
    elif meta.has_field("patient"):
        filters["patient"] = patient

    existing = None
    if filters:
        rows = frappe.get_all(
            dt,
            filters=filters,
            fields=["name", "docstatus"],
            order_by="modified desc",
            limit=1,
        )
        # update only draft PRF; do not overwrite approved/submitted one
        if rows and rows[0].docstatus == 0:
            existing = rows[0].name

    if existing:
        doc = frappe.get_doc(dt, existing)
    else:
        doc = frappe.new_doc(dt)

    # Do not set workflow_state before save. Preserve current state.
    old_workflow_state = doc.get("workflow_state") if meta.has_field("workflow_state") else None

    set_if_has(doc, "custom_patient", p.name)
    set_if_has(doc, "patient", p.name)

    set_if_has(doc, "custom_mr_number", p.get("custom_reference_number"))
    set_if_has(doc, "mr_no", p.get("custom_reference_number"))

    patient_display_name = (
        p.get("patient_name")
        or " ".join([str(p.get("first_name") or ""), str(p.get("last_name") or "")]).strip()
        or p.name
    )

    set_if_has(doc, "custom_patient_name", patient_display_name)
    set_if_has(doc, "patient_full_name", patient_display_name)

    set_if_has(doc, "custom_patient_customer", p.get("customer"))
    set_if_has(doc, "custom_billing_type", patient_type)

    # keep duplicate purpose fields synced
    set_if_has(doc, "purpose", funding_source)
    set_if_has(doc, "custom_kpws_welfare_type", funding_source)
    set_if_has(doc, "custom_kpws_funding_source", funding_source)

    # keep duplicate percentage fields synced
    set_if_has(doc, "discount_value", percentage)
    set_if_has(doc, "custom_kpws_welfare_percentage", percentage)

    # panel fields
    set_if_has(doc, "custom_panel_customer", panel_customer)
    set_if_has(doc, "custom_kpws_assigned_panel_customer", panel_customer)

    # restore workflow_state before save so workflow validation does not fail
    if meta.has_field("workflow_state"):
        doc.workflow_state = old_workflow_state or "Draft"

    doc.flags.ignore_permissions = True
    doc.save(ignore_permissions=True)

    # After save, mark as Pending Approval safely.
    if meta.has_field("workflow_state"):
        try:
            frappe.db.set_value(
                dt,
                doc.name,
                "workflow_state",
                "Pending Approval",
                update_modified=False,
            )
        except Exception:
            # fallback: keep as draft, but do not block creation
            pass

    # Add a comment for admin visibility
    try:
        doc.add_comment(
            "Info",
            "Sent for welfare approval from KPWS Patient Intake at {0}".format(now_datetime()),
        )
    except Exception:
        pass

    frappe.db.commit()

    return {
        "ok": True,
        "registration": doc.name,
        "docstatus": frappe.db.get_value(dt, doc.name, "docstatus"),
        "workflow_state": frappe.db.get_value(dt, doc.name, "workflow_state") if meta.has_field("workflow_state") else None,
        "purpose": funding_source,
        "percentage": percentage,
        "panel_customer": panel_customer,
        "context": get_patient_context(p.name) if "get_patient_context" in globals() else {},
    }


