@frappe.whitelist()
def approve_patient_registration(name):
    """
    Approve Patient Registration Form from custom button.

    It does not depend on ERPNext workflow buttons being visible.
    """
    import frappe

    prf = _kpws_v56_get_prf(name)

    if prf.docstatus == 1:
        return {
            "ok": True,
            "message": "Already approved/submitted.",
            "name": prf.name,
            "docstatus": prf.docstatus,
            "workflow_state": prf.get("workflow_state"),
        }

    # Set workflow state safely before submit
    if prf.meta.has_field("workflow_state"):
        try:
            frappe.db.set_value(
                "Patient Registration Form",
                prf.name,
                "workflow_state",
                "Approved",
                update_modified=False,
            )
            prf.reload()
        except Exception:
            pass

    # Sync approved values back to Patient
    _kpws_v56_sync_prf_to_patient(prf)

    # Submit the PRF
    try:
        prf.flags.ignore_permissions = True
        prf.flags.ignore_workflow = True
        frappe.flags.ignore_workflow = True
        prf.submit()
    except Exception:
        # If workflow still blocks submit, keep doc as approved draft instead of breaking
        if prf.meta.has_field("workflow_state"):
            frappe.db.set_value(
                "Patient Registration Form",
                prf.name,
                "workflow_state",
                "Approved",
                update_modified=False,
            )
        frappe.db.commit()
        return {
            "ok": True,
            "message": "Marked as Approved. Submit was blocked by workflow, but approval state was saved.",
            "name": prf.name,
            "docstatus": frappe.db.get_value("Patient Registration Form", prf.name, "docstatus"),
            "workflow_state": frappe.db.get_value("Patient Registration Form", prf.name, "workflow_state"),
        }

    frappe.db.commit()

    return {
        "ok": True,
        "message": "Patient Registration Approved.",
        "name": prf.name,
        "docstatus": frappe.db.get_value("Patient Registration Form", prf.name, "docstatus"),
        "workflow_state": frappe.db.get_value("Patient Registration Form", prf.name, "workflow_state"),
    }


