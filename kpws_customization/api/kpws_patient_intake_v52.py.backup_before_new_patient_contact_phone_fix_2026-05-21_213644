@frappe.whitelist()
def search_patients(query=None):
    import frappe

    query = (query or "").strip()
    if not query:
        return []

    like = "%" + query + "%"

    columns = {r[0] for r in frappe.db.sql("SHOW COLUMNS FROM `tabPatient`")}

    search_fields = [
        "name",
        "patient_name",
        "first_name",
        "last_name",
        "custom_reference_number",
        "custom_kpws_cnic",
        "cnic",
        "cnic_number",
        "custom_cnic",
        "custom_cnic_number",
        "mobile",
        "mobile_no",
        "phone",
        "custom_kpws_mobile_no",
    ]

    existing = [f for f in search_fields if f in columns]

    conditions = " OR ".join([f"`{f}` LIKE %(like)s" for f in existing])

    fields = [
        "name",
        "patient_name",
        "first_name",
        "last_name",
        "custom_reference_number",
        "customer_group",
        "customer",
        "custom_panel_customer",
    ]

    select_fields = [f"`{f}`" for f in fields if f in columns]

    if "custom_kpws_cnic" in columns:
        select_fields.append("`custom_kpws_cnic`")
    elif "cnic" in columns:
        select_fields.append("`cnic`")

    if not select_fields:
        select_fields = ["`name`"]

    rows = frappe.db.sql(
        f"""
        SELECT {", ".join(select_fields)}
        FROM `tabPatient`
        WHERE {conditions}
        ORDER BY modified DESC
        LIMIT 20
        """,
        {"like": like},
        as_dict=True,
    )

    for r in rows:
        if not r.get("patient_name"):
            r["patient_name"] = " ".join([
                str(r.get("first_name") or "").strip(),
                str(r.get("last_name") or "").strip(),
            ]).strip()

    return rows


