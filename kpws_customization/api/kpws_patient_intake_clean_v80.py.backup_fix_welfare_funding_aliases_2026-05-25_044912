import json
import re
import frappe
from frappe.utils import nowdate, now_datetime, flt, cint
from kpws_customization.api.kpws_patient_extra_fields import sync_extra_fields_from_patient_to_prf

COMPANY = "Kiran Patient Welfare Society"

PATIENT_TYPES = ("Cash", "Welfare", "Panel", "Personal Advance")
WELFARE_SOURCES = ("Zakat", "Donation", "Panel")


def _parse_payload(payload=None, data=None, kwargs=None):
    out = {}

    def merge(v):
        if not v:
            return
        if isinstance(v, dict):
            out.update(v)
            return
        if isinstance(v, str):
            try:
                out.update(json.loads(v))
            except Exception:
                pass

    merge(payload)
    merge(data)
    merge(kwargs or {})

    for k, v in dict(frappe.form_dict).items():
        if k == "cmd":
            continue
        if k in ("payload", "data"):
            merge(v)
        else:
            out[k] = v

    return out


def _meta(dt):
    return frappe.get_meta(dt)


def _has(dt, fieldname):
    try:
        return frappe.get_meta(dt).has_field(fieldname)
    except Exception:
        return False


def _set(doc, fieldname, value, allow_blank=False):
    if not doc.meta.has_field(fieldname):
        return
    if value in (None, "") and not allow_blank:
        return
    doc.set(fieldname, value)


def _db_set(dt, name, values):
    clean = {}
    for fieldname, value in values.items():
        if _has(dt, fieldname):
            clean[fieldname] = value
    if clean:
        frappe.db.set_value(dt, name, clean, update_modified=True)


def _normalize_cnic(v):
    return "".join(ch for ch in str(v or "") if ch.isdigit())


def _display_patient_name(p):
    return (
        p.get("patient_name")
        or " ".join([str(p.get("first_name") or "").strip(), str(p.get("last_name") or "").strip()]).strip()
        or p.name
    )


def _validate_patient_type(patient_type, funding_source=None, panel_customer=None):
    patient_type = (patient_type or "").strip()
    funding_source = (funding_source or "").strip()
    panel_customer = (panel_customer or "").strip()

    if patient_type not in PATIENT_TYPES:
        frappe.throw("Patient Type must be Cash, Welfare, Panel, or Personal Advance.")

    if patient_type in ("Cash", "Personal Advance"):
        return patient_type, "", ""

    if patient_type == "Panel":
        if not panel_customer:
            frappe.throw("Panel Name is required for Panel patient.")
        _validate_panel_customer(panel_customer)
        return patient_type, "", panel_customer

    if patient_type == "Welfare":
        if funding_source not in WELFARE_SOURCES:
            frappe.throw("Funding Source is required for Welfare patient.")

        if funding_source == "Panel":
            if not panel_customer:
                frappe.throw("Panel Name is required when Welfare Funding Source is Panel.")
            _validate_panel_customer(panel_customer)
            return patient_type, funding_source, panel_customer

        return patient_type, funding_source, ""

    return patient_type, funding_source, panel_customer


def _validate_panel_customer(customer):
    if not customer or not frappe.db.exists("Customer", customer):
        frappe.throw("Selected Panel Customer does not exist.")

    if _has("Customer", "custom_is_panel"):
        is_panel = cint(frappe.db.get_value("Customer", customer, "custom_is_panel") or 0)
        if is_panel != 1:
            frappe.throw("Selected Panel Customer is not marked as Is Panel.")


def _check_duplicate_cnic(cnic, current_patient=None):
    norm = _normalize_cnic(cnic)
    if not norm:
        return

    fields = ["custom_kpws_cnic", "cnic_number", "cnic", "custom_cnic", "custom_cnic_number"]

    for fieldname in fields:
        if not _has("Patient", fieldname):
            continue

        rows = frappe.get_all(
            "Patient",
            filters={fieldname: ["is", "set"]},
            fields=["name", fieldname],
            limit=5000,
        )

        for row in rows:
            if current_patient and row.name == current_patient:
                continue
            if _normalize_cnic(row.get(fieldname)) == norm:
                frappe.throw(f"Patient already exists with this CNIC. Existing Patient: {row.name}")


def _patient_values_from_payload(data):
    first_name = (data.get("first_name") or "").strip()
    last_name = (data.get("last_name") or "").strip()
    patient_name = (data.get("patient_name") or "").strip()

    if not first_name and patient_name:
        parts = patient_name.split()
        first_name = parts[0]
        last_name = " ".join(parts[1:]) if len(parts) > 1 else last_name

    age = data.get("age_") or data.get("age")
    sex = data.get("sex") or data.get("gender")
    mobile = data.get("mobile") or data.get("mobile_no") or data.get("custom_kpws_mobile_no")
    cnic = data.get("custom_kpws_cnic") or data.get("cnic") or data.get("cnic_number")
    mr = data.get("custom_reference_number") or data.get("mr_number") or data.get("kiran_mr_number")
    patient_status = data.get("patient_status") or "SE"
    patient_type = data.get("patient_type") or data.get("customer_group") or "Cash"
    funding_source = data.get("funding_source") or data.get("custom_kpws_funding_source") or ""
    panel_customer = data.get("panel_customer") or data.get("custom_panel_customer") or ""
    notes = data.get("patient_details") or data.get("notes") or data.get("remarks") or ""

    if not first_name:
        frappe.throw("First Name is required.")
    if not age:
        frappe.throw("Age is required.")
    if not sex:
        frappe.throw("Gender is required.")
    if not cnic:
        frappe.throw("CNIC is required.")

    patient_type, funding_source, panel_customer = _validate_patient_type(patient_type, funding_source, panel_customer)

    return {
        "first_name": first_name,
        "last_name": last_name,
        "age_": age,
        "sex": sex,
        "mobile": mobile,
        "custom_kpws_mobile_no": mobile,
        "custom_kpws_cnic": cnic,
        "cnic_number": cnic,
        "custom_reference_number": mr,
        "patient_status": patient_status,
        "customer_group": patient_type,
        "custom_kpws_funding_source": funding_source,
        "custom_panel_customer": panel_customer,
        "patient_details": notes,
    }


@frappe.whitelist()
def save_patient(payload=None, data=None, **kwargs):
    """
    Clean Patient save.

    New Patient: creates Patient once.
    Existing Patient: direct DB update only; no Patient.save(); no Customer creation.
    """
    data = _parse_payload(payload, data, kwargs)

    patient = data.get("patient") or data.get("name") or data.get("patient_id")
    existing = patient if patient and frappe.db.exists("Patient", patient) else None

    values = _patient_values_from_payload(data)
    _check_duplicate_cnic(values.get("custom_kpws_cnic"), existing)

    # Keep phone fields away from insert to avoid Healthcare Contact primary phone conflict.
    mobile_updates = {}
    for f in ("mobile", "phone", "custom_kpws_mobile_no"):
        if _has("Patient", f):
            mobile_updates[f] = values.get("mobile") or values.get("custom_kpws_mobile_no") or ""

    insert_values = dict(values)
    insert_values.pop("mobile", None)
    insert_values.pop("phone", None)
    insert_values.pop("custom_kpws_mobile_no", None)

    if existing:
        old_customer = frappe.db.get_value("Patient", existing, "customer")

        updates = {}
        for k, v in values.items():
            if _has("Patient", k):
                updates[k] = v if v is not None else ""

        frappe.db.set_value("Patient", existing, updates, update_modified=True)

        # Critical safety: never replace linked customer during patient update.
        if old_customer and _has("Patient", "customer"):
            frappe.db.set_value("Patient", existing, "customer", old_customer, update_modified=False)

        frappe.db.commit()
        return get_patient_context(existing)

    doc = frappe.new_doc("Patient")

    for k, v in insert_values.items():
        _set(doc, k, v, allow_blank=True)

    # Fill mandatory defaults safely.
    for df in doc.meta.fields:
        if cint(df.reqd) and not doc.get(df.fieldname):
            if df.fieldtype == "Select":
                opts = [x for x in (df.options or "").split("\n") if x]
                if opts:
                    doc.set(df.fieldname, opts[0])
            elif df.fieldtype == "Link" and df.options == "Gender":
                doc.set(df.fieldname, values.get("sex"))
            elif df.fieldtype in ("Data", "Text", "Small Text"):
                doc.set(df.fieldname, values.get("first_name"))
            elif df.fieldtype in ("Int", "Float", "Currency"):
                doc.set(df.fieldname, 0)

    doc.insert(ignore_permissions=True)

    if mobile_updates:
        frappe.db.set_value("Patient", doc.name, mobile_updates, update_modified=False)

    frappe.db.commit()
    return get_patient_context(doc.name)


@frappe.whitelist()
def change_patient_classification(patient=None, patient_type=None, funding_source=None, panel_customer=None, reason=None):
    """
    Controlled patient type / funding source update.

    Never creates Customer.
    Never updates Patient.customer.
    Never calls Patient.save().
    """
    if not patient or not frappe.db.exists("Patient", patient):
        frappe.throw("Please select a valid Patient.")

    patient_type, funding_source, panel_customer = _validate_patient_type(patient_type, funding_source, panel_customer)

    p = frappe.get_doc("Patient", patient)

    # KPWS_REAL_EXTRA_FIELDS_UPDATE_PATIENT_BEFORE_PRF_V1
    _extra_changed = False
    if religion is not None and p.meta.has_field("custom_religion"):
        p.set("custom_religion", religion or "")
        _extra_changed = True
    if sanction is not None and p.meta.has_field("custom_sanction"):
        p.set("custom_sanction", sanction or "")
        _extra_changed = True
    if nationality is not None and p.meta.has_field("custom_nationality"):
        p.set("custom_nationality", nationality or "")
        _extra_changed = True
    if _extra_changed:
        p.save(ignore_permissions=True)
    old_customer = p.get("customer")

    before = {
        "patient_type": p.get("customer_group"),
        "funding_source": p.get("custom_kpws_funding_source") if p.meta.has_field("custom_kpws_funding_source") else None,
        "panel_customer": p.get("custom_panel_customer") if p.meta.has_field("custom_panel_customer") else None,
        "customer": old_customer,
    }

    updates = {
        "customer_group": patient_type,
        "custom_kpws_funding_source": funding_source,
        "custom_panel_customer": panel_customer,
    }

    _db_set("Patient", patient, updates)

    if old_customer and _has("Patient", "customer"):
        frappe.db.set_value("Patient", patient, "customer", old_customer, update_modified=False)

    try:
        comment = (
            f"Classification changed from {before.get('patient_type') or '-'} / "
            f"{before.get('funding_source') or '-'} / {before.get('panel_customer') or '-'} "
            f"to {patient_type} / {funding_source or '-'} / {panel_customer or '-'}."
        )
        if reason:
            comment += f" Reason: {reason}"
        frappe.get_doc("Patient", patient).add_comment("Info", comment)
    except Exception:
        pass

    frappe.db.commit()
    return get_patient_context(patient)


@frappe.whitelist()
def get_patient_context(patient=None):
    if not patient or not frappe.db.exists("Patient", patient):
        frappe.throw("Patient not found.")

    p = frappe.get_doc("Patient", patient)
    patient_type = p.get("customer_group") or "Cash"

    ctx = {
        "ok": True,
        "patient": p.name,
        "patient_name": _display_patient_name(p),
        "first_name": p.get("first_name"),
        "last_name": p.get("last_name"),
        "age": p.get("age_"),
        "sex": p.get("sex"),
        "mobile": p.get("custom_kpws_mobile_no") or p.get("mobile"),
        "cnic": p.get("custom_kpws_cnic") or p.get("cnic_number"),
        "mr_number": p.get("custom_reference_number"),
        "patient_status": p.get("patient_status"),
        "patient_type": patient_type,
        "funding_source": p.get("custom_kpws_funding_source") if p.meta.has_field("custom_kpws_funding_source") else "",
        "panel_customer": p.get("custom_panel_customer") if p.meta.has_field("custom_panel_customer") else "",
        "customer": p.get("customer"),
        "customer_name": frappe.db.get_value("Customer", p.get("customer"), "customer_name") if p.get("customer") else "",
        "welfare_registration": None,
        "latest_token": None,
        "personal_advance": None,
    }

    # Token for all patient types
    if frappe.db.exists("DocType", "Patient Token"):
        rows = frappe.get_all(
            "Patient Token",
            filters={"patient": p.name},
            fields=["name", "status", "creation"],
            order_by="creation desc",
            limit=1,
        )
        if rows:
            ctx["latest_token"] = {
                "name": rows[0].name,
                "status": rows[0].status,
                "created": str(rows[0].creation),
            }

    # Welfare status only when current Patient Type is Welfare.
    if patient_type == "Welfare" and frappe.db.exists("DocType", "Patient Registration Form"):
        rows = frappe.get_all(
            "Patient Registration Form",
            filters={"custom_patient": p.name},
            fields=["name", "docstatus", "workflow_state", "modified"],
            order_by="modified desc",
            limit=1,
        )
        if rows:
            prf = frappe.get_doc("Patient Registration Form", rows[0].name)
            ctx["welfare_registration"] = {
                "name": prf.name,
                "docstatus": prf.docstatus,
                "workflow_state": prf.get("workflow_state"),
                "purpose": prf.get("custom_kpws_welfare_type") or prf.get("custom_kpws_funding_source") or prf.get("purpose"),
                "percentage": prf.get("custom_kpws_welfare_percentage") or prf.get("discount_value"),
                "panel_customer": prf.get("custom_panel_customer") or prf.get("custom_kpws_assigned_panel_customer"),
                "modified": str(prf.modified),
            }

    # Personal Advance balance only when type is Personal Advance.
    if patient_type == "Personal Advance":
        ctx["personal_advance"] = get_personal_advance_balance(patient=p.name)

    return ctx


@frappe.whitelist()
def search_patients(query=None):
    query = (query or "").strip()
    if not query:
        return []

    like = "%" + query + "%"
    columns = {r[0] for r in frappe.db.sql("SHOW COLUMNS FROM `tabPatient`")}

    fields = ["name", "patient_name", "first_name", "last_name", "custom_reference_number", "customer_group", "customer"]
    fields = [f for f in fields if f in columns]

    search_fields = [
        "name", "patient_name", "first_name", "last_name",
        "custom_reference_number", "custom_kpws_cnic", "cnic_number",
        "mobile", "custom_kpws_mobile_no"
    ]
    search_fields = [f for f in search_fields if f in columns]

    where = " OR ".join([f"`{f}` LIKE %(like)s" for f in search_fields])

    rows = frappe.db.sql(
        f"""
        SELECT {", ".join("`" + f + "`" for f in fields)}
        FROM `tabPatient`
        WHERE {where}
        ORDER BY modified DESC
        LIMIT 20
        """,
        {"like": like},
        as_dict=True,
    )
    return rows


@frappe.whitelist()
def get_panel_customers(txt=None):
    txt = (txt or "").strip()

    if not _has("Customer", "custom_is_panel"):
        return []

    filters = {"custom_is_panel": 1}
    if _has("Customer", "disabled"):
        filters["disabled"] = 0

    rows = frappe.get_all(
        "Customer",
        filters=filters,
        fields=["name", "customer_name"],
        order_by="customer_name asc",
        limit=500,
    )

    if txt:
        t = txt.lower()
        rows = [r for r in rows if t in (r.name or "").lower() or t in (r.customer_name or "").lower()]

    return [{"value": r.name, "label": r.customer_name or r.name} for r in rows]


@frappe.whitelist()
def create_panel_customer(panel_name=None):
    panel_name = re.sub(r"\s+", " ", (panel_name or "").strip())

    if not panel_name:
        frappe.throw("Panel Name is required.")

    if frappe.db.exists("Customer", panel_name):
        frappe.throw(f"Customer already exists: {panel_name}")

    existing = frappe.db.sql(
        """
        SELECT name
        FROM `tabCustomer`
        WHERE LOWER(TRIM(customer_name)) = LOWER(TRIM(%s))
        LIMIT 1
        """,
        panel_name,
        as_dict=True,
    )
    if existing:
        frappe.throw(f"Customer already exists with same name: {existing[0].name}")

    if not frappe.db.exists("Customer Group", "Panel"):
        frappe.throw("Customer Group Panel does not exist.")

    if not frappe.db.exists("Territory", "Pakistan"):
        root = "All Territories" if frappe.db.exists("Territory", "All Territories") else frappe.db.get_value("Territory", {"is_group": 1}, "name")
        terr = frappe.new_doc("Territory")
        terr.territory_name = "Pakistan"
        terr.parent_territory = root
        terr.is_group = 0
        terr.insert(ignore_permissions=True)

    c = frappe.new_doc("Customer")
    c.customer_name = panel_name
    c.customer_type = "Company"
    c.customer_group = "Panel"
    c.territory = "Pakistan"

    _set(c, "custom_is_panel", 1)
    _set(c, "custom_kpws_is_advance_customer", 0, allow_blank=True)

    c.insert(ignore_permissions=True)
    frappe.db.commit()

    return {"ok": True, "customer": c.name, "label": c.customer_name, "value": c.name}


@frappe.whitelist()
def create_or_update_registration(patient=None, funding_source=None, percentage=100, panel_customer=None, religion=None, sanction=None, nationality=None, **kwargs):
    if not patient or not frappe.db.exists("Patient", patient):
        frappe.throw("Please save/select a valid Patient first.")

    p = frappe.get_doc("Patient", patient)

    if p.get("customer_group") != "Welfare":
        frappe.throw("Welfare Registration can only be created for Welfare patient.")

    funding_source = funding_source or p.get("custom_kpws_funding_source")
    panel_customer = panel_customer or p.get("custom_panel_customer")
    percentage = flt(percentage or 100)

    if funding_source not in WELFARE_SOURCES:
        frappe.throw("Funding Source must be Zakat, Donation, or Panel.")

    if funding_source == "Panel":
        _validate_panel_customer(panel_customer)

    if funding_source in ("Zakat", "Donation") and percentage <= 0:
        frappe.throw("Approved percentage is required.")

    dt = "Patient Registration Form"

    existing = frappe.get_all(
        dt,
        filters={"custom_patient": p.name, "docstatus": 0},
        fields=["name"],
        order_by="modified desc",
        limit=1,
    )

    doc = frappe.get_doc(dt, existing[0].name) if existing else frappe.new_doc(dt)

    _set(doc, "custom_patient", p.name)
    _set(doc, "custom_patient_name", _display_patient_name(p))
    _set(doc, "custom_mr_number", p.get("custom_reference_number"), allow_blank=True)
    _set(doc, "purpose", funding_source)
    _set(doc, "custom_kpws_welfare_type", funding_source)
    _set(doc, "custom_kpws_funding_source", funding_source)
    _set(doc, "discount_value", percentage)
    _set(doc, "custom_kpws_welfare_percentage", percentage)
    _set(doc, "custom_panel_customer", panel_customer, allow_blank=True)
    _set(doc, "custom_kpws_assigned_panel_customer", panel_customer, allow_blank=True)

    if doc.meta.has_field("workflow_state"):
        doc.workflow_state = doc.workflow_state or "Draft"

    # Fill simple required fields if any custom fields are mandatory.
    for df in doc.meta.fields:
        if cint(df.reqd) and not doc.get(df.fieldname):
            if df.fieldtype == "Link" and df.options == "Patient":
                doc.set(df.fieldname, p.name)
            elif df.fieldtype == "Select":
                opts = [x for x in (df.options or "").split("\n") if x]
                if opts:
                    doc.set(df.fieldname, opts[0])
            elif df.fieldtype in ("Data", "Text", "Small Text"):
                doc.set(df.fieldname, _display_patient_name(p))
            elif df.fieldtype in ("Float", "Percent", "Currency", "Int"):
                doc.set(df.fieldname, 0)
            elif df.fieldtype == "Date":
                doc.set(df.fieldname, nowdate())

    # KPWS_REAL_EXTRA_FIELDS_COPY_TO_PRF_V1
    _religion_value = p.get("custom_religion") or ""
    _sanction_value = p.get("custom_sanction") or ""
    _nationality_value = p.get("custom_nationality") or ""

    if doc.meta.has_field("religion1"):
        doc.set("religion1", _religion_value)
    elif doc.meta.has_field("religion"):
        doc.set("religion", _religion_value)

    if doc.meta.has_field("sanction"):
        doc.set("sanction", _sanction_value)
    elif doc.meta.has_field("saction1"):
        doc.set("saction1", _sanction_value)

    if doc.meta.has_field("nationality"):
        doc.set("nationality", _nationality_value)

    # Also set custom fields if they exist in metadata
    if doc.meta.has_field("custom_religion"):
        doc.set("custom_religion", _religion_value)
    if doc.meta.has_field("custom_nationality"):
        doc.set("custom_nationality", _nationality_value)

    # KPWS_FIX_INVALID_PRF_WORKFLOW_STATE_V1
    # Ensure Patient Registration Form has a valid workflow_state before save.
    # This prevents: "Pending Approval is not a valid Workflow State"
    try:
        if doc.meta.has_field("workflow_state"):
            active_workflow = frappe.db.get_value(
                "Workflow",
                {
                    "document_type": dt,
                    "is_active": 1,
                },
                "name",
            )

            if active_workflow:
                wf = frappe.get_doc("Workflow", active_workflow)

                valid_states = []
                draft_states = []

                for st in wf.states:
                    state_name = st.state
                    valid_states.append(state_name)

                    try:
                        doc_status = int(st.doc_status or 0)
                    except Exception:
                        doc_status = 0

                    if doc_status == 0:
                        draft_states.append(state_name)

                current_state = doc.get("workflow_state")

                if current_state not in valid_states:
                    preferred_state = None

                    for candidate in [
                        "Draft",
                        "Submitted",
                        "Pending",
                        "Pending Review",
                        "Under Review",
                        "Open",
                    ]:
                        if candidate in valid_states:
                            preferred_state = candidate
                            break

                    if not preferred_state and draft_states:
                        preferred_state = draft_states[0]

                    if not preferred_state and valid_states:
                        preferred_state = valid_states[0]

                    if preferred_state:
                        doc.set("workflow_state", preferred_state)
            else:
                # If no active workflow exists, clear invalid workflow state.
                current_state = doc.get("workflow_state")
                if current_state == "Pending Approval":
                    doc.set("workflow_state", None)
    except Exception:
        frappe.log_error(frappe.get_traceback(), "KPWS PRF workflow state normalization failed")

    doc.save(ignore_permissions=True)

    if doc.meta.has_field("workflow_state"):
        frappe.db.set_value(dt, doc.name, "workflow_state", "Pending Approval", update_modified=False)

    frappe.db.commit()

    # KPWS_EXTRA_FIELDS_SYNC_TO_PRF_V1
    try:
        _sync_patient = patient or data.get("patient") or data.get("custom_patient") or data.get("patient_id")
    except Exception:
        _sync_patient = None

    try:
        _sync_prf = doc.name
    except Exception:
        _sync_prf = None

    try:
        if _sync_patient and _sync_prf:
            sync_extra_fields_from_patient_to_prf(_sync_patient, _sync_prf)
    except Exception:
        frappe.log_error(frappe.get_traceback(), "KPWS extra fields sync to PRF failed")

    return get_patient_context(p.name)


@frappe.whitelist()
def create_token(patient=None):
    if not patient or not frappe.db.exists("Patient", patient):
        frappe.throw("Please save/select a valid Patient first.")

    p = frappe.get_doc("Patient", patient)

    doc = frappe.new_doc("Patient Token")
    _set(doc, "patient", p.name)
    _set(doc, "patient_name", _display_patient_name(p))
    _set(doc, "status", "Entitled")

    for df in doc.meta.fields:
        if cint(df.reqd) and not doc.get(df.fieldname):
            if df.fieldtype == "Link" and df.options == "Patient":
                doc.set(df.fieldname, p.name)
            elif df.fieldtype == "Select":
                opts = [x for x in (df.options or "").split("\n") if x]
                if opts:
                    doc.set(df.fieldname, opts[0])
            elif df.fieldtype in ("Data", "Text", "Small Text"):
                doc.set(df.fieldname, _display_patient_name(p))
            elif df.fieldtype == "Date":
                doc.set(df.fieldname, nowdate())

    doc.insert(ignore_permissions=True)
    frappe.db.commit()

    return get_patient_context(p.name)


@frappe.whitelist()
def get_personal_advance_balance(patient=None, customer=None):
    if not customer and patient and frappe.db.exists("Patient", patient):
        customer = frappe.db.get_value("Patient", patient, "customer")

    if not customer or not frappe.db.exists("Customer", customer):
        return {"ok": False, "customer": customer, "available_advance": 0, "entries": []}

    entries = frappe.db.sql(
        """
        SELECT name, posting_date, mode_of_payment, paid_amount, unallocated_amount
        FROM `tabPayment Entry`
        WHERE docstatus = 1
          AND payment_type = 'Receive'
          AND party_type = 'Customer'
          AND party = %s
          AND IFNULL(unallocated_amount, 0) > 0
        ORDER BY posting_date ASC, creation ASC
        """,
        customer,
        as_dict=True,
    )

    return {
        "ok": True,
        "customer": customer,
        "available_advance": sum(flt(x.unallocated_amount) for x in entries),
        "entries": entries,
    }


@frappe.whitelist()
def approve_patient_registration(name=None):
    if not name or not frappe.db.exists("Patient Registration Form", name):
        frappe.throw("Patient Registration Form not found.")

    prf = frappe.get_doc("Patient Registration Form", name)

    if prf.docstatus == 1:
        return {"ok": True, "message": "Already approved.", "name": prf.name}

    if prf.meta.has_field("workflow_state"):
        frappe.db.set_value("Patient Registration Form", prf.name, "workflow_state", "Approved", update_modified=False)
        prf.reload()

    patient = prf.get("custom_patient")
    if patient and frappe.db.exists("Patient", patient):
        updates = {
            "customer_group": "Welfare",
            "custom_kpws_funding_source": prf.get("custom_kpws_welfare_type") or prf.get("purpose") or prf.get("custom_kpws_funding_source"),
            "custom_panel_customer": prf.get("custom_panel_customer") or prf.get("custom_kpws_assigned_panel_customer") or "",
        }
        old_customer = frappe.db.get_value("Patient", patient, "customer")
        _db_set("Patient", patient, updates)
        if old_customer and _has("Patient", "customer"):
            frappe.db.set_value("Patient", patient, "customer", old_customer, update_modified=False)

    try:
        prf.submit()
    except Exception:
        pass

    frappe.db.commit()
    return {"ok": True, "message": "Approved.", "name": prf.name}


@frappe.whitelist()
def reject_patient_registration(name=None, reason=None):
    if not name or not frappe.db.exists("Patient Registration Form", name):
        frappe.throw("Patient Registration Form not found.")

    prf = frappe.get_doc("Patient Registration Form", name)

    if prf.docstatus == 1:
