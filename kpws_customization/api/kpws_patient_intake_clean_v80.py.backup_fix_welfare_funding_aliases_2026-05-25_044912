# KPWS_FINAL_PATIENT_INTAKE_SAVE_V83
@frappe.whitelist()
def save_patient(payload=None, data=None, **kwargs):
    """
    Final clean Patient Intake save.

    Fixes:
    - CNIC payload not being picked correctly.
    - Old v82 wrapper calling old save_patient again.
    - TypeError: keywords must be strings from frappe.new_doc path.
    - Existing Patient update must not create/replace Customer.
    - Existing original Patient fields are linked:
        Son of/Daughter of/Wife of
        Old KPWS Number
    """
    import json
    import frappe
    from frappe.utils import cint

    def parse_any(v):
        if not v:
            return {}
        if isinstance(v, dict):
            return dict(v)
        if isinstance(v, str):
            try:
                return json.loads(v)
            except Exception:
                return {}
        try:
            return dict(v)
        except Exception:
            return {}

    raw = {}
    raw.update(parse_any(payload))
    raw.update(parse_any(data))
    raw.update(parse_any(kwargs))

    for k, v in dict(frappe.form_dict).items():
        if k == "cmd":
            continue
        if k in ("payload", "data"):
            raw.update(parse_any(v))
        else:
            raw[k] = v

    lower = {str(k).lower(): v for k, v in raw.items()}

    def pick(*keys):
        for key in keys:
            if key in raw and raw.get(key) not in (None, ""):
                return raw.get(key)
            lk = str(key).lower()
            if lk in lower and lower.get(lk) not in (None, ""):
                return lower.get(lk)
        return ""

    def has(fieldname):
        return frappe.get_meta("Patient").has_field(fieldname)

    def add(updates, fieldname, value, allow_blank=False):
        if not has(fieldname):
            return
        if value in (None, "") and not allow_blank:
            return
        updates[fieldname] = value

    def normalize_cnic(v):
        return "".join(ch for ch in str(v or "") if ch.isdigit())

    def find_patient_field_by_label_or_keywords(labels, keywords, avoid=None):
        avoid = set(avoid or [])
        meta = frappe.get_meta("Patient")
        candidates = []

        for df in meta.fields:
            fieldname = df.fieldname or ""
            label = df.label or ""
            combined = (fieldname + " " + label).lower()

            score = 0

            for lbl in labels:
                if lbl.lower() == label.lower():
                    score += 100
                elif lbl.lower() in label.lower():
                    score += 70

            for kw in keywords:
                if kw.lower() in combined:
                    score += 30

            if fieldname in avoid:
                score -= 20

            if score > 0:
                candidates.append((score, fieldname))

        candidates.sort(reverse=True)
        return candidates[0][1] if candidates else None

    relation_field = find_patient_field_by_label_or_keywords(
        labels=["Son of/Daughter of/Wife of", "Father/Husband Name", "Guardian Name"],
        keywords=["son", "daughter", "wife", "father", "husband", "guardian", "relation"],
        avoid=["custom_kpws_relation_name"],
    )

    old_kpws_field = find_patient_field_by_label_or_keywords(
        labels=["Old KPWS Number", "Old KPWS No"],
        keywords=["old", "kpws"],
        avoid=["custom_old_kpws_number"],
    )

    patient = pick("patient", "name", "patient_id", "patient_docname")
    existing_patient = patient if patient and frappe.db.exists("Patient", patient) else None

    first_name = pick("first_name", "patient_first_name")
    last_name = pick("last_name", "patient_last_name")
    patient_name = pick("patient_name", "full_name", "name_text")

    if not first_name and patient_name:
        parts = str(patient_name).strip().split()
        if parts:
            first_name = parts[0]
            if not last_name and len(parts) > 1:
                last_name = " ".join(parts[1:])

    age = pick("age_", "age", "patient_age")
    sex = pick("sex", "gender", "patient_gender")
    mobile = pick("mobile", "mobile_no", "phone", "custom_kpws_mobile_no")
    cnic = pick(
        "custom_kpws_cnic",
        "cnic",
        "cnic_number",
        "custom_cnic",
        "custom_cnic_number",
        "patient_cnic",
    )
    mr_number = pick("custom_reference_number", "mr_number", "kiran_mr_number", "mr_no")
    patient_status = pick("patient_status", "status") or "SE"

    patient_type = pick("patient_type", "customer_group", "billing_type") or "Cash"
    funding_source = pick("funding_source", "custom_kpws_funding_source")
    panel_customer = pick("panel_customer", "custom_panel_customer")
    notes = pick("patient_details", "notes", "remarks")

    # KPWS_REAL_EXTRA_FIELDS_PICK_V1
    religion = pick("custom_religion", "religion", "religion1")
    sanction = pick("custom_sanction", "sanction", "saction", "saction1")
    nationality = pick("custom_nationality", "nationality")

    relation_value = pick(
        "relation_name",
        "son_of_daughter_of_wife_of",
        "father_husband_name",
        "guardian_name",
        "custom_kpws_relation_name",
    )

    old_kpws_value = pick(
        "old_kpws_number",
        "old_kpws_no",
        "kpws_old_number",
        "custom_old_kpws_number",
    )

    # If existing patient and field is blank in payload, preserve existing mandatory values.
    if existing_patient:
        if not cnic:
            for f in ["custom_kpws_cnic", "cnic_number", "cnic", "custom_cnic", "custom_cnic_number"]:
                if has(f):
                    cnic = frappe.db.get_value("Patient", existing_patient, f)
                    if cnic:
                        break

        if not age and has("age_"):
            age = frappe.db.get_value("Patient", existing_patient, "age_")

        if not sex and has("sex"):
            sex = frappe.db.get_value("Patient", existing_patient, "sex")

        if not first_name:
            first_name = frappe.db.get_value("Patient", existing_patient, "first_name")

    if not first_name:
        frappe.throw("First Name is required.")

    if not cnic:
        frappe.throw("CNIC is required.")

    if not age:
        frappe.throw("Age is required.")

    if not sex:
        frappe.throw("Gender is required.")

    allowed_types = ("Cash", "Welfare", "Panel", "Personal Advance")
    if patient_type not in allowed_types:
        frappe.throw("Patient Type must be Cash, Welfare, Panel, or Personal Advance.")

    if patient_type in ("Cash", "Personal Advance"):
        funding_source = ""
        panel_customer = ""

    elif patient_type == "Panel":
        funding_source = ""
        if not panel_customer:
            frappe.throw("Panel Name is required for Panel patient.")

    elif patient_type == "Welfare":
        if funding_source not in ("Zakat", "Donation", "Panel"):
            frappe.throw("Funding Source is required for Welfare patient.")
        if funding_source == "Panel" and not panel_customer:
            frappe.throw("Panel Name is required when Welfare Funding Source is Panel.")
        if funding_source in ("Zakat", "Donation"):
            panel_customer = ""

    if panel_customer:
        if not frappe.db.exists("Customer", panel_customer):
            frappe.throw("Selected Panel Customer does not exist.")
        if frappe.get_meta("Customer").has_field("custom_is_panel"):
            is_panel = cint(frappe.db.get_value("Customer", panel_customer, "custom_is_panel") or 0)
            if is_panel != 1:
                frappe.throw("Selected Panel Customer is not marked as Is Panel.")

    # CNIC duplicate check
    cnic_norm = normalize_cnic(cnic)
    for f in ["custom_kpws_cnic", "cnic_number", "cnic", "custom_cnic", "custom_cnic_number"]:
        if not has(f):
            continue

        rows = frappe.get_all("Patient", filters={f: ["is", "set"]}, fields=["name", f], limit=5000)
        for row in rows:
            if existing_patient and row.name == existing_patient:
                continue
            if cnic_norm and normalize_cnic(row.get(f)) == cnic_norm:
                frappe.throw("Patient already exists with this CNIC. Existing Patient: {0}".format(row.name))

    updates = {}

    add(updates, "first_name", first_name)
    add(updates, "last_name", last_name, allow_blank=True)
    add(updates, "age_", age)
    add(updates, "sex", sex)
    add(updates, "mobile", mobile, allow_blank=True)
    add(updates, "custom_kpws_mobile_no", mobile, allow_blank=True)
    add(updates, "custom_kpws_cnic", cnic)
    add(updates, "cnic_number", cnic, allow_blank=True)
    add(updates, "custom_reference_number", mr_number, allow_blank=True)
    add(updates, "patient_status", patient_status)
    add(updates, "customer_group", patient_type)
    add(updates, "custom_kpws_funding_source", funding_source, allow_blank=True)
    add(updates, "custom_panel_customer", panel_customer, allow_blank=True)
    add(updates, "patient_details", notes, allow_blank=True)

    # KPWS_REAL_EXTRA_FIELDS_PATIENT_SAVE_V1
    add(updates, "custom_religion", religion, allow_blank=True)
    add(updates, "custom_sanction", sanction, allow_blank=True)
    add(updates, "custom_nationality", nationality, allow_blank=True)

    if relation_field and has(relation_field):
        updates[relation_field] = relation_value or ""

    if old_kpws_field and has(old_kpws_field):
        updates[old_kpws_field] = old_kpws_value or ""

    if existing_patient:
        old_customer = frappe.db.get_value("Patient", existing_patient, "customer")

        frappe.db.set_value("Patient", existing_patient, updates, update_modified=True)

        # Critical: never overwrite/create Customer from intake update.
        if old_customer and has("customer"):
            frappe.db.set_value("Patient", existing_patient, "customer", old_customer, update_modified=False)

        frappe.db.commit()
        return get_patient_context(existing_patient)

    # New patient: create with controlled string-key dict to avoid frappe.new_doc TypeError.
    insert_doc = {"doctype": "Patient"}

    # Keep phone/mobile away from insert to avoid Healthcare Contact phone conflict.
    post_insert_updates = {}

    for k, v in updates.items():
        if k in ("mobile", "phone", "custom_kpws_mobile_no"):
            post_insert_updates[k] = v
        else:
            insert_doc[str(k)] = v

    doc = frappe.get_doc(insert_doc)

    # Fill any mandatory fallback fields.
    for df in doc.meta.fields:
        if cint(df.reqd) and not doc.get(df.fieldname):
            if df.fieldtype == "Select":
                opts = [x for x in (df.options or "").split("\n") if x]
                if opts:
                    doc.set(df.fieldname, opts[0])
            elif df.fieldtype == "Link" and df.options == "Gender":
                doc.set(df.fieldname, sex)
            elif df.fieldtype in ("Data", "Small Text", "Text"):
                doc.set(df.fieldname, first_name)
            elif df.fieldtype in ("Int", "Float", "Currency"):
                doc.set(df.fieldname, 0)

    doc.insert(ignore_permissions=True)

    if post_insert_updates:
        frappe.db.set_value("Patient", doc.name, post_insert_updates, update_modified=False)

    frappe.db.commit()
    return get_patient_context(doc.name)


