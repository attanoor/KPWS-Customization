    except Exception:
        pass

    frappe.db.commit()
    return {"ok": True, "message": "Rejected.", "name": prf.name}


# KPWS_LINK_EXISTING_PATIENT_FIELDS_V82
# Link existing original Patient fields to Patient Intake.
# This does NOT create any new Custom Field.

try:
    _kpws_v82_original_save_patient = save_patient
except Exception:
    _kpws_v82_original_save_patient = None

try:
    _kpws_v82_original_get_patient_context = get_patient_context
except Exception:
    _kpws_v82_original_get_patient_context = None


def _kpws_v82_norm(txt):
    import re
    return re.sub(r"[^a-z0-9]+", "", (txt or "").lower())


def _kpws_v82_find_patient_field(kind):
    """
    Dynamically find existing Patient fields.

    kind = relation:
      Son of/Daughter of/Wife of / Father Name / Guardian / Husband etc.

    kind = old_kpws:
      Old KPWS Number / Old KPWS No etc.

    Priority:
      1. Existing original fields by label/fieldname
      2. Avoid fields we accidentally created earlier if another better field exists
      3. Fallback to any matching custom field
    """
    import frappe

    meta = frappe.get_meta("Patient")
    rows = []

    for df in meta.fields:
        label = df.label or ""
        fieldname = df.fieldname or ""
        label_n = _kpws_v82_norm(label)
        field_n = _kpws_v82_norm(fieldname)

        score = 0

        if kind == "relation":
            if "sonofdaughterofwifeof" in label_n:
                score += 100
            if "father" in label_n or "husband" in label_n or "guardian" in label_n or "relation" in label_n:
                score += 60
            if "father" in field_n or "husband" in field_n or "guardian" in field_n or "relation" in field_n:
                score += 40
            # Avoid our accidentally-created duplicate if there is a better original field
            if fieldname == "custom_kpws_relation_name":
                score -= 20

        elif kind == "old_kpws":
            if "oldkpwsnumber" in label_n or "oldkpwsno" in label_n:
                score += 100
            if "old" in label_n and "kpws" in label_n:
                score += 90
            if "old" in field_n and "kpws" in field_n:
                score += 70
            # Avoid our accidentally-created duplicate if there is a better original field
            if fieldname == "custom_old_kpws_number":
                score -= 20

        if score > 0:
            rows.append({
                "fieldname": fieldname,
                "label": label,
                "fieldtype": df.fieldtype,
                "score": score,
            })

    rows = sorted(rows, key=lambda x: x["score"], reverse=True)

    if rows:
        return rows[0]["fieldname"]

    return None


def _kpws_v82_relation_field():
    return _kpws_v82_find_patient_field("relation")


def _kpws_v82_old_kpws_field():
    return _kpws_v82_find_patient_field("old_kpws")


def _kpws_v82_parse_payload(payload=None, data=None, kwargs=None):
    import json
    import frappe

    out = {}

    def merge(v):
        if not v:
            return
        if isinstance(v, dict):
            out.update(v)
            return
        if isinstance(v, str):
            try:
                out.update(json.loads(v))
            except Exception:
                pass

    merge(payload)
    merge(data)
    merge(kwargs or {})

    for k, v in dict(frappe.form_dict).items():
        if k == "cmd":
            continue
        if k in ("payload", "data"):
            merge(v)
        else:
            out[k] = v

    return out


def _kpws_v82_pick(data, *keys):
    lower = {str(k).lower(): v for k, v in (data or {}).items()}

    for key in keys:
        if key in data and data.get(key) not in (None, ""):
            return data.get(key)

        lk = str(key).lower()
        if lk in lower and lower.get(lk) not in (None, ""):
            return lower.get(lk)

    return ""


def _kpws_v82_save_extra_patient_fields(patient, data):
    import frappe

    if not patient or not frappe.db.exists("Patient", patient):
        return

    updates = {}

    relation_field = _kpws_v82_relation_field()
    old_kpws_field = _kpws_v82_old_kpws_field()

    relation_value = _kpws_v82_pick(
        data,
        "relation_name",
        "son_of_daughter_of_wife_of",
        "father_husband_name",
        "guardian_name",
        "custom_kpws_relation_name",
    )

    old_kpws_value = _kpws_v82_pick(
        data,
        "old_kpws_number",
        "old_kpws_no",
        "kpws_old_number",
        "custom_old_kpws_number",
    )

    if relation_field:
        updates[relation_field] = relation_value or ""

    if old_kpws_field:
        updates[old_kpws_field] = old_kpws_value or ""

    if updates:
        frappe.db.set_value("Patient", patient, updates, update_modified=True)
        frappe.db.commit()


@frappe.whitelist()
def save_patient(payload=None, data=None, **kwargs):
    """
    Wrapper around clean v80 save_patient.
    Adds existing original Patient fields mapping:
      - Son of/Daughter of/Wife of
      - Old KPWS Number
    """
    import frappe

    raw = _kpws_v82_parse_payload(payload, data, kwargs)

    if not _kpws_v82_original_save_patient:
        frappe.throw("Original clean save_patient function not found.")

    result = _kpws_v82_original_save_patient(payload=payload, data=data, **kwargs)

    patient = None

    if isinstance(result, dict):
        patient = result.get("patient") or result.get("name")

    if not patient:
        patient = raw.get("patient") or raw.get("name") or raw.get("patient_id")

    if patient:
        _kpws_v82_save_extra_patient_fields(patient, raw)
        return get_patient_context(patient)

    return result


@frappe.whitelist()
def get_patient_context(patient=None):
    """
    Wrapper around clean v80 get_patient_context.
    Adds existing original Patient field values to screen context.
    """
    import frappe

    if not _kpws_v82_original_get_patient_context:
        frappe.throw("Original clean get_patient_context function not found.")

    ctx = _kpws_v82_original_get_patient_context(patient=patient)

    if not patient and isinstance(ctx, dict):
        patient = ctx.get("patient")

    if patient and frappe.db.exists("Patient", patient):
        rel_field = _kpws_v82_relation_field()
