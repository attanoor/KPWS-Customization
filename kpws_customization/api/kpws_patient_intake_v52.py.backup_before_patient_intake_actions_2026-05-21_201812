        FROM `tabCustomer`
        WHERE {where}
        ORDER BY customer_name ASC
        LIMIT %(limit)s
    """, values, as_dict=True)


@frappe.whitelist()
def create_or_update_registration(patient, purpose=None, percentage=None, panel_customer=None, submit=0):
    if not patient or not frappe.db.exists(PATIENT_DT, patient):
        frappe.throw("Patient is required")
    if not _has_doctype(PRF_DT):
        frappe.throw("Patient Registration Form doctype not found")
    p = frappe.get_doc(PATIENT_DT, patient)
    funding = purpose or p.get("custom_kpws_funding_source") or "Zakat"
    if funding not in ["Zakat", "Donation", "Panel"]:
        funding = "Zakat"
    percentage = flt(percentage if percentage is not None else 100)
    panel_customer = panel_customer or p.get("custom_panel_customer")
    if funding == "Panel" and not panel_customer:
        frappe.throw("Panel Customer is required for Welfare Panel approval")
    if funding in ["Zakat", "Donation"] and percentage <= 0:
        frappe.throw("Percentage is required for Zakat/Donation approval")

    # Reuse latest draft if available; otherwise create new.
    rows = frappe.get_all(PRF_DT, filters={"custom_patient": patient, "docstatus": 0} if _has_field(PRF_DT, "custom_patient") else {}, fields=["name"], order_by="modified desc", limit=1)
    if rows:
        prf = frappe.get_doc(PRF_DT, rows[0].name)
    else:
        prf = frappe.new_doc(PRF_DT)

    _set_if_has(prf, "custom_patient", patient)
    _set_if_has(prf, "custom_kpws_source_patient", patient)
    _set_if_has(prf, "custom_mr_number", p.get("custom_reference_number"))
    _set_if_has(prf, "custom_patient_name", p.get("patient_name"))
    _set_if_has(prf, "custom_patient_customer", p.get("customer"))
    _set_if_has(prf, "custom_billing_type", p.get("customer_group"))
    _set_if_has(prf, "purpose", funding)
    _set_if_has(prf, "custom_kpws_welfare_type", funding)
    _set_if_has(prf, "custom_kpws_funding_source", funding)
    _set_if_has(prf, "discount_value", percentage)
    _set_if_has(prf, "custom_kpws_welfare_percentage", percentage)
    _set_if_has(prf, "custom_panel_customer", panel_customer)
    _set_if_has(prf, "custom_kpws_assigned_panel_customer", panel_customer)
    prf.save(ignore_permissions=True)

    if cint(submit) and prf.docstatus == 0:
        prf.submit()

    # Sync back to patient
    _set_if_has(p, "custom_kpws_funding_source", funding)
    _set_if_has(p, "custom_panel_customer", panel_customer)
    _set_if_has(p, "custom_kpws_active_prf", prf.name)
    _set_if_has(p, "custom_kpws_approval_status", "Approved" if prf.docstatus == 1 else "Pending Approval")
    p.save(ignore_permissions=True)
    frappe.db.commit()
    return {"registration": prf.name, "docstatus": prf.docstatus, "patient": _serialize_patient(patient)}


