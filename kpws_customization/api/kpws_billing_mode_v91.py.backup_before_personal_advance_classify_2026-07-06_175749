    db = frappe.get_doc("Sales Invoice", doc.name)
    for f in ("customer", "customer_name", "debit_to", "is_pos", "pos_profile", "selling_price_list", "status", "outstanding_amount"):
        if doc.meta.has_field(f):
            doc.set(f, db.get(f))
    doc.is_pos = 0
    doc.pos_profile = None
    doc.set("payments", [])


