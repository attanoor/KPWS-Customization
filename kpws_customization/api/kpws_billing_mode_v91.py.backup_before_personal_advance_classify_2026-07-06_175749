def _existing_payment(si_name, mode_of_payment):
    rows = frappe.db.sql("""
        SELECT pe.name
        FROM `tabPayment Entry Reference` ref
        JOIN `tabPayment Entry` pe ON pe.name = ref.parent
        WHERE ref.reference_doctype='Sales Invoice'
          AND ref.reference_name=%s
          AND pe.mode_of_payment=%s
          AND pe.docstatus=1
        LIMIT 1
    """, (si_name, mode_of_payment), as_dict=True)
    return rows[0].name if rows else None


def _create_receive_payment(si, mode_of_payment, amount, forced_paid_to=None):
    amount = flt(amount, 2)
    if amount <= 0:
        return None
    if not mode_of_payment:
        frappe.throw(_("Patient share Mode of Payment is missing."))
    existing = _existing_payment(si.name, mode_of_payment)
    if existing:
        return existing
    paid_to = forced_paid_to or _mop_account(mode_of_payment, si.company)
    if not paid_to:
        frappe.throw(_("Mode of Payment {0} has no default account for company {1}.").format(mode_of_payment, si.company))
    receivable = si.debit_to or _get_party_account("Customer", si.customer, si.company)
    pe = frappe.new_doc("Payment Entry")
    pe.payment_type = "Receive"
    pe.company = si.company
    pe.posting_date = si.posting_date or nowdate()
    pe.mode_of_payment = mode_of_payment
    pe.party_type = "Customer"
    pe.party = si.customer
    pe.paid_from = receivable
    pe.paid_to = paid_to
    pe.paid_amount = amount
    pe.received_amount = amount
    pe.reference_no = si.name
    pe.reference_date = si.posting_date or nowdate()
    pe.append("references", {"reference_doctype": "Sales Invoice", "reference_name": si.name, "allocated_amount": amount})
    pe.insert(ignore_permissions=True)
    pe.submit()
    return pe.name


def _existing_welfare_je(si_name):
    rows = frappe.db.sql("""
        SELECT je.name
        FROM `tabJournal Entry Account` acc
        JOIN `tabJournal Entry` je ON je.name = acc.parent
        WHERE acc.reference_type='Sales Invoice'
          AND acc.reference_name=%s
          AND acc.credit_in_account_currency > 0
          AND je.docstatus=1
        LIMIT 1
    """, si_name, as_dict=True)
    return rows[0].name if rows else None


def _create_welfare_journal(si, amount, purpose):
    amount = flt(amount, 2)
    if amount <= 0:
        return None
    existing = _existing_welfare_je(si.name)
    if existing:
        return existing
    funding = _funding(purpose) or "Zakat"
    if funding == "Donation":
        expense = _get_setting("donation_disbursement_account")
    else:
        expense = _get_setting("zakat_disbursement_account")
    if not expense:
        frappe.throw(_("Missing {0} disbursement account in KPWS Pharmacy Billing Settings.").format(funding))
    je = frappe.new_doc("Journal Entry")
    je.voucher_type = "Journal Entry"
    je.company = si.company
    je.posting_date = si.posting_date or nowdate()
    je.user_remark = "Auto {0} welfare settlement against Sales Invoice {1}".format(funding, si.name)
    je.append("accounts", {"account": expense, "debit_in_account_currency": amount})
    je.append("accounts", {"account": si.debit_to, "party_type": "Customer", "party": si.customer, "reference_type": "Sales Invoice", "reference_name": si.name, "credit_in_account_currency": amount})
    je.insert(ignore_permissions=True)
    je.submit()
    return je.name


def _refresh_invoice_status(si_name):
    si = frappe.get_doc("Sales Invoice", si_name)
    try:
        si.set_status(update=True)
    except Exception:
        pass
    frappe.db.commit()


def _settle_patient_share(si, patient_share=None):
    settings = _settings()
    patient_share = flt(patient_share if patient_share is not None else si.get("custom_kpws_patient_share_amount"), 2)
    cash = flt(si.get("custom_kpws_patient_cash_amount"), 2) if si.meta.has_field("custom_kpws_patient_cash_amount") else 0
    card = flt(si.get("custom_kpws_patient_card_amount"), 2) if si.meta.has_field("custom_kpws_patient_card_amount") else 0
    if patient_share > 0 and flt(cash + card, 2) <= 0:
        cash = patient_share
        _db_set_if_has(si, "custom_kpws_patient_cash_amount", cash)
    if cash > 0:
        pe = _create_receive_payment(si, _get_cash_mop(settings), cash, CASH_PHARMACY_ACCOUNT if _is_ledger_account(CASH_PHARMACY_ACCOUNT) else None)
        _db_set_if_has(si, "custom_kpws_cash_payment_entry", pe)
    if card > 0:
        pe = _create_receive_payment(si, _get_card_mop(settings), card, None)
        _db_set_if_has(si, "custom_kpws_card_payment_entry", pe)


def settle_welfare_panel_invoice(si_name):
    si = frappe.get_doc("Sales Invoice", si_name)
    before_submit_sales_invoice(si)
    total = _invoice_total(si)
    percentage = flt(si.get("custom_kpws_approved_percentage") or 100, 2)
    pct, covered, share = _split(total, percentage)
    _db_set_if_has(si, "custom_kpws_billing_type_final", "Welfare Panel")
    _db_set_if_has(si, "custom_kpws_patient_billing_group", "Welfare Panel")
    _db_set_if_has(si, "custom_kpws_welfare_covered_amount", covered)
    _db_set_if_has(si, "custom_kpws_patient_share_amount", share)
    _settle_patient_share(si, share)
    _refresh_invoice_status(si.name)


def settle_welfare_invoice(si_name):
    si = frappe.get_doc("Sales Invoice", si_name)
    before_submit_sales_invoice(si)
    total = _invoice_total(si)
    percentage = flt(si.get("custom_kpws_approved_percentage") or 100, 2)
    pct, covered, share = _split(total, percentage)
    _db_set_if_has(si, "custom_kpws_welfare_covered_amount", covered)
    _db_set_if_has(si, "custom_kpws_patient_share_amount", share)
    _settle_patient_share(si, share)
    if covered > 0:
        je = _create_welfare_journal(si, covered, si.get("custom_kpws_purpose") or "Zakat")
        _db_set_if_has(si, "custom_kpws_auto_journal_entry", je)
    _refresh_invoice_status(si.name)


def on_submit_sales_invoice(doc, method=None):
    if getattr(frappe.flags, "kpws_billing_mode_v91_running", False):
        return
    billing = _invoice_billing_type(doc)
    try:
        frappe.flags.kpws_billing_mode_v91_running = True
        if billing == "Welfare Panel":
            settle_welfare_panel_invoice(doc.name)
        elif billing in ("Welfare", "Welfare Zakat", "Welfare Donation"):
            settle_welfare_invoice(doc.name)
    finally:
        frappe.flags.kpws_billing_mode_v91_running = False


def before_cancel_sales_invoice(doc, method=None):
    for field, doctype in (("custom_kpws_cash_payment_entry", "Payment Entry"), ("custom_kpws_card_payment_entry", "Payment Entry"), ("custom_kpws_auto_journal_entry", "Journal Entry")):
        name = doc.get(field) if doc.meta.has_field(field) else None
        if name and frappe.db.exists(doctype, name):
            d = frappe.get_doc(doctype, name)
            if d.docstatus == 1:
                d.cancel()


def protect_submitted_invoice_before_save(doc, method=None):
