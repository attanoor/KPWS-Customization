@frappe.whitelist()
def audit_recent(limit=20):
    cols = {r[0] for r in frappe.db.sql("SHOW COLUMNS FROM `tabSales Invoice`")}
    wanted = ["name", "posting_date", "customer", "customer_name", "docstatus", "status", "grand_total", "outstanding_amount", "is_pos", "debit_to", "selling_price_list", "patient", "custom_patient", "custom_kpws_billing_type_final", "custom_kpws_patient_billing_group", "custom_kpws_purpose", "custom_kpws_approved_percentage", "custom_kpws_panel_customer", "custom_kpws_welfare_covered_amount", "custom_kpws_patient_share_amount", "custom_kpws_cash_payment_entry", "custom_kpws_card_payment_entry", "custom_kpws_auto_journal_entry"]
    fields = [f for f in wanted if f in cols]
    rows = frappe.get_all("Sales Invoice", fields=fields, order_by="creation desc", limit=cint(limit or 20))
    out = []
    for row in rows:
        row = frappe._dict(row)
        issues = []
        billing = row.get("custom_kpws_billing_type_final") or row.get("custom_kpws_patient_billing_group")
        if billing in ("Panel", "Welfare Panel", "Welfare Zakat", "Welfare Donation") and row.get("is_pos"):
            issues.append("Non-cash KPWS invoice should not be POS")
        if billing == "Welfare Panel" and row.get("custom_kpws_auto_journal_entry"):
            issues.append("Welfare Panel must not create Zakat/Donation JE")
        if billing == "Welfare Panel" and row.get("debit_to") == _get_welfare_receivable_account():
            issues.append("Welfare Panel should use Panel Receivable, not Welfare Receivable")
        row["issues"] = issues
        out.append(row)
    return out


# KPWS_AUDIT_PATCH_A2_20260620: safer cancellation of KPWS auto settlement docs
def before_cancel_sales_invoice(doc, method=None):
    for field, doctype in (
        ("custom_kpws_cash_payment_entry", "Payment Entry"),
        ("custom_kpws_card_payment_entry", "Payment Entry"),
        ("custom_kpws_auto_journal_entry", "Journal Entry"),
    ):
        name = doc.get(field) if doc.meta.has_field(field) else None
        if not name or not frappe.db.exists(doctype, name):
            continue
        d = frappe.get_doc(doctype, name)
        if d.docstatus == 1:
            d.flags.ignore_permissions = True
            d.flags.ignore_links = True
            d.cancel()
        if doc.meta.has_field(field):
            doc.set(field, None)
