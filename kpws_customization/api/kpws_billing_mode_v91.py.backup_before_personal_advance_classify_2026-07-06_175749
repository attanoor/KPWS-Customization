def validate_patient_registration_form(doc, method=None):
    """Welfare Panel means Purpose=Zakat/Donation plus Panel Customer; Purpose must not be Panel."""
    purpose = _funding(doc.get("custom_kpws_funding_source") or doc.get("custom_kpws_welfare_type") or doc.get("purpose")) or "Zakat"
    if purpose == "Panel":
        frappe.throw(_("For Welfare Panel, select Funding Source as Zakat or Donation, then select the Panel Customer separately. Do not use Panel as the welfare purpose."))
    if purpose not in ("Zakat", "Donation"):
        purpose = "Zakat"
    for f in ("custom_kpws_funding_source", "custom_kpws_welfare_type", "purpose"):
        if doc.meta.has_field(f):
            doc.set(f, purpose)
    pct = flt(doc.get("custom_kpws_welfare_percentage") or doc.get("discount_value") or 100, 2)
    if pct <= 0:
        frappe.throw(_("Approved percentage is required for Welfare {0} approval.").format(purpose))
    if pct > 100:
        frappe.throw(_("Approved percentage cannot be greater than 100%."))
    for f in ("custom_kpws_welfare_percentage", "discount_value"):
        if doc.meta.has_field(f):
            doc.set(f, pct)
    panel = None
    for f in ("custom_panel_customer", "custom_kpws_assigned_panel_customer", "panel_customer"):
        if doc.meta.has_field(f) and doc.get(f):
            panel = doc.get(f)
            break
    if panel:
        _validate_panel_customer(panel, "Selected Welfare Panel customer is not valid.")


