frappe.provide("kpws");
frappe.pages["kpws-patient-intake"].on_page_load = function(wrapper) { new kpws.PatientIntakeV53(wrapper); };

kpws.PatientIntakeV53 = class {
    constructor(wrapper) {
        this.wrapper = wrapper;
        this.page = frappe.ui.make_app_page({ parent: wrapper, title: __("KPWS Patient Intake"), single_column: true });
        this.state = { patient: null, context: null };
        this.make();
        this.load_boot();
    }
    make() {
        this.$root = $(`
        <div class="kpws-v53">
            <style>
                .kpws-v53{padding:12px}.kpws-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:16px}.kpws-card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:16px;box-shadow:0 1px 8px rgba(0,0,0,.04);margin-bottom:14px}.kpws-card h3{margin:0 0 12px;font-size:16px;font-weight:700;color:#111827}.kpws-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.kpws-row-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.kpws-search-row{display:flex;gap:10px;align-items:center}.kpws-search-row input{flex:1;height:38px;border:1px solid #d1d5db;border-radius:10px;padding:8px 12px}.kpws-results{margin-top:8px;max-height:180px;overflow:auto}.kpws-result{padding:8px 10px;border:1px solid #e5e7eb;border-radius:10px;margin-bottom:6px;cursor:pointer}.kpws-result:hover{background:#f9fafb}.kpws-badge{display:inline-flex;padding:4px 9px;border-radius:999px;font-size:12px;font-weight:700;background:#eef2ff;color:#3730a3}.kpws-badge.green{background:#ecfdf5;color:#047857}.kpws-badge.orange{background:#fff7ed;color:#c2410c}.kpws-badge.red{background:#fef2f2;color:#b91c1c}.kpws-badge.purple{background:#f5f3ff;color:#6d28d9}.kpws-actions{display:flex;flex-wrap:wrap;gap:10px}.kpws-muted{color:#6b7280;font-size:12px}.kpws-decision{line-height:1.55}.kpws-hidden{display:none!important}@media(max-width:980px){.kpws-grid,.kpws-row,.kpws-row-3{grid-template-columns:1fr}}
            </style>
            <div class="kpws-card"><h3>Find Patient</h3><div class="kpws-search-row"><input type="text" data-field="search" placeholder="Search by CNIC / MR No / Mobile / Patient Name"><button class="btn btn-primary" data-action="search">Search</button><button class="btn btn-default" data-action="new">New Patient</button></div><div class="kpws-results" data-area="results"></div></div>
            <div class="kpws-grid"><div>
                <div class="kpws-card"><h3>Patient Registration</h3><div class="kpws-row"><div data-control="patient_name"></div><div data-control="cnic"></div><div data-control="mr_number"></div><div data-control="old_kpws_number"></div><div data-control="age"></div><div data-control="sex"></div><div data-control="mobile"></div><div data-control="patient_status"></div></div><div style="margin-top:12px" data-control="patient_details"></div></div>
                <div class="kpws-card"><h3>Classification</h3><div class="kpws-row-3"><div data-control="patient_type"></div><div data-wrap="funding_source" data-control="funding_source"></div><div data-wrap="approved_percentage" data-control="approved_percentage"></div><div data-wrap="panel_customer" data-control="panel_customer"></div></div><div class="kpws-muted" style="margin-top:10px">Cash shows no funding source. Welfare shows Zakat / Donation / Panel. Panel shows Panel Name only.</div></div>
                <div class="kpws-card"><h3>Actions</h3><div class="kpws-actions"><button class="btn btn-primary" data-action="save">Save Patient</button><button class="btn btn-default" data-action="token">Create Token</button><button class="btn btn-warning" data-action="approval">Send for Welfare Approval</button><button class="btn btn-default" data-action="open_prf">Open Welfare Registration</button><button class="btn btn-success" data-action="billing">Open Pharmacy Billing</button></div></div>
            </div><div>
                <div class="kpws-card"><h3>Patient Snapshot</h3><div data-area="snapshot" class="kpws-decision"><span class="kpws-muted">No patient selected yet.</span></div></div>
                <div class="kpws-card"><h3>Welfare Registration Status</h3><div data-area="welfare_status" class="kpws-decision"><span class="kpws-muted">Save/select a welfare patient to view status.</span></div></div>
                <div class="kpws-card"><h3>Billing Decision Preview</h3><div data-area="decision" class="kpws-decision"><span class="kpws-muted">Billing logic will appear after patient type is selected.</span></div></div>
            </div></div>
        </div>`).appendTo(this.page.main);
        this.make_controls(); this.bind(); this.apply_filters();
    }
    make_control(fieldname, df) { let parent=this.$root.find(`[data-control="${fieldname}"]`).get(0); let c=frappe.ui.form.make_control({parent, df:Object.assign({fieldname},df), render_input:true}); c.refresh(); this[fieldname]=c; return c; }
    make_controls(){
        this.make_control("patient_name",{label:"Patient Name",fieldtype:"Data",reqd:1}); this.make_control("cnic",{label:"CNIC",fieldtype:"Data",reqd:1}); this.make_control("mr_number",{label:"Kiran MR Number",fieldtype:"Data"}); this.make_control("old_kpws_number",{label:"Old KPWS No",fieldtype:"Data"}); this.make_control("age",{label:"Age",fieldtype:"Int",reqd:1}); this.make_control("sex",{label:"Gender",fieldtype:"Select",options:"\nMale\nFemale\nOther",reqd:1}); this.make_control("mobile",{label:"Mobile",fieldtype:"Data"}); this.make_control("patient_status",{label:"Patient Status",fieldtype:"Select",options:"SE\nE\nNE\nP",default:"SE"}); this.make_control("patient_details",{label:"Patient Details / Address / Notes",fieldtype:"Small Text"});
        this.make_control("patient_type",{label:"Patient Type",fieldtype:"Select",options:"Cash\nWelfare\nPanel\nPersonal Advance",default:"Cash",reqd:1,onchange:()=>this.apply_filters()}); this.make_control("funding_source",{label:"Funding Source",fieldtype:"Select",options:"\nZakat\nDonation\nPanel",onchange:()=>this.apply_filters()}); this.make_control("approved_percentage",{label:"Approved %",fieldtype:"Percent",default:100}); this.make_control("panel_customer",{label:"Panel Name",fieldtype:"Link",options:"Customer",get_query:()=>({filters:{custom_is_panel:1}})});
    }
    bind(){ this.$root.on("click","[data-action='search']",()=>this.search()); this.$root.on("click","[data-action='new']",()=>this.reset_form()); this.$root.on("click","[data-action='save']",()=>this.save_patient()); this.$root.on("click","[data-action='approval']",()=>this.send_for_approval()); this.$root.on("click","[data-action='token']",()=>this.create_token()); this.$root.on("click","[data-action='open_prf']",()=>this.open_prf()); this.$root.on("click","[data-action='billing']",()=>this.open_billing()); this.$root.find("[data-field='search']").on("keydown",e=>{ if(e.key==="Enter") this.search(); }); }
    load_boot(){ frappe.call({method:"kpws_customization.api.kpws_patient_intake_v53.get_boot"}); }
    getv(f){ return this[f] ? this[f].get_value() : null; } setv(f,v){ if(this[f]) this[f].set_value(v||""); }
    apply_filters(){ const t=this.getv("patient_type")||"Cash", s=this.getv("funding_source")||""; this.$root.find("[data-wrap='funding_source']").toggleClass("kpws-hidden", t!=="Welfare"); this.$root.find("[data-wrap='approved_percentage']").toggleClass("kpws-hidden", t!=="Welfare"); this.$root.find("[data-wrap='panel_customer']").toggleClass("kpws-hidden", !(t==="Panel"||(t==="Welfare"&&s==="Panel"))); if(t==="Cash"){this.setv("funding_source","");this.setv("panel_customer","");} if(t==="Panel") this.setv("funding_source",""); if(t==="Welfare"&&!this.getv("approved_percentage")) this.setv("approved_percentage",100); this.render_decision(); }
    payload(){ return {patient:this.state.patient, patient_name:this.getv("patient_name"), cnic:this.getv("cnic"), mr_number:this.getv("mr_number"), old_kpws_number:this.getv("old_kpws_number"), age:this.getv("age"), sex:this.getv("sex"), mobile:this.getv("mobile"), patient_status:this.getv("patient_status")||"SE", patient_details:this.getv("patient_details"), patient_type:this.getv("patient_type")||"Cash", funding_source:this.getv("funding_source"), approved_percentage:this.getv("approved_percentage")||100, panel_customer:this.getv("panel_customer")}; }
    search(){ const q=this.$root.find("[data-field='search']").val(); if(!q){frappe.msgprint("Enter CNIC, MR No, Mobile, or Patient Name.");return;} frappe.call({method:"kpws_customization.api.kpws_patient_intake_v53.search_patients",args:{query:q},callback:r=>{ const rows=r.message||[], $res=this.$root.find("[data-area='results']").empty(); if(!rows.length){$res.html(`<div class="kpws-muted">No patient found. You can create a new patient.</div>`);return;} rows.forEach(row=>{let $i=$(`<div class="kpws-result"><b>${frappe.utils.escape_html(row.label||row.name)}</b><div class="kpws-muted">Patient: ${row.name||""} | MR: ${row.mr_number||"-"} | CNIC: ${row.cnic||"-"}</div></div>`); $i.on("click",()=>this.load_patient(row.name)); $res.append($i);}); }}); }
    load_patient(p){ frappe.call({method:"kpws_customization.api.kpws_patient_intake_v53.get_context",args:{patient:p},callback:r=>this.apply_context(r.message||{})}); }
    apply_context(ctx){ this.state.context=ctx; const p=ctx.patient||{}; this.state.patient=p.name||null; this.setv("patient_name",p.patient_name); this.setv("cnic",p.cnic); this.setv("mr_number",p.mr_number); this.setv("old_kpws_number",p.old_kpws_number); this.setv("age",p.age); this.setv("sex",p.sex); this.setv("mobile",p.mobile); this.setv("patient_status",p.patient_status||"SE"); this.setv("patient_details",p.patient_details); this.setv("patient_type",p.customer_group||"Cash"); this.setv("funding_source",p.funding_source); this.setv("panel_customer",p.panel_customer); if((ctx.prf||{}).percentage) this.setv("approved_percentage",(ctx.prf||{}).percentage); this.apply_filters(); this.render_snapshot(); this.render_welfare_status(); this.render_decision(); this.$root.find("[data-area='results']").empty(); }
    reset_form(){ this.state.patient=null; this.state.context=null; ["patient_name","cnic","mr_number","old_kpws_number","age","sex","mobile","patient_details","funding_source","panel_customer"].forEach(f=>this.setv(f,"")); this.setv("patient_status","SE"); this.setv("patient_type","Cash"); this.setv("approved_percentage",100); this.apply_filters(); this.render_snapshot(); this.render_welfare_status(); this.render_decision(); }
    save_patient(){ frappe.call({method:"kpws_customization.api.kpws_patient_intake_v53.save_patient",args:{payload:JSON.stringify(this.payload())},freeze:true,freeze_message:"Saving patient...",callback:r=>{frappe.show_alert({message:"Patient saved",indicator:"green"}); this.apply_context(r.message||{});}}); }
    send_for_approval(){ if(!this.state.patient){frappe.msgprint("Please save/select a patient first.");return;} frappe.call({method:"kpws_customization.api.kpws_patient_intake_v53.send_for_welfare_approval",args:{patient:this.state.patient},freeze:true,freeze_message:"Creating welfare registration...",callback:r=>{frappe.show_alert({message:(r.message||{}).message||"Sent for approval",indicator:"green"}); this.apply_context((r.message||{}).context||{});}}); }
    create_token(){ if(!this.state.patient){frappe.msgprint("Please save/select a patient first.");return;} frappe.call({method:"kpws_customization.api.kpws_patient_intake_v53.create_token",args:{patient:this.state.patient},freeze:true,freeze_message:"Creating token...",callback:r=>{frappe.show_alert({message:(r.message||{}).message||"Token created",indicator:"green"}); this.load_patient(this.state.patient);}}); }
    open_prf(){ const prf=((this.state.context||{}).prf||{}).name; if(!prf){frappe.msgprint("No Welfare Registration found. Use Send for Welfare Approval first.");return;} frappe.set_route("Form","Patient Registration Form",prf); }
    open_billing(){ frappe.set_route("kpws-pharmacy-billing"); }
    render_snapshot(){ const p=((this.state.context||{}).patient||{}); if(!p.name){this.$root.find("[data-area='snapshot']").html(`<span class="kpws-muted">No patient selected yet.</span>`);return;} this.$root.find("[data-area='snapshot']").html(`<div><b>${frappe.utils.escape_html(p.patient_name||p.name)}</b></div><div class="kpws-muted">Patient ID: ${p.name}</div><div>MR No: <b>${p.mr_number||"-"}</b></div><div>CNIC: <b>${p.cnic||"-"}</b></div><div>Type: <span class="kpws-badge">${p.customer_group||"-"}</span></div><div>Panel: <b>${p.panel_customer||"-"}</b></div><div>Advance Balance: <b>${format_currency((this.state.context||{}).advance_balance||0)}</b></div>`); }
    render_welfare_status(){ const p=((this.state.context||{}).patient||{}), prf=((this.state.context||{}).prf||{}); if(!p.name){this.$root.find("[data-area='welfare_status']").html(`<span class="kpws-muted">Save/select a welfare patient to view status.</span>`);return;} if((p.customer_group||"")!=="Welfare"){this.$root.find("[data-area='welfare_status']").html(`<span class="kpws-badge green">Not Required</span><div class="kpws-muted">Welfare Registration is only required for Welfare patients.</div>`);return;} if(!prf.name){this.$root.find("[data-area='welfare_status']").html(`<span class="kpws-badge red">Missing</span><div class="kpws-muted">Click Send for Welfare Approval.</div>`);return;} const st=prf.docstatus==1?"Approved/Submitted":(prf.workflow_state||"Pending Approval"); this.$root.find("[data-area='welfare_status']").html(`<div>Registration: <b>${prf.name}</b></div><div>Status: <span class="kpws-badge orange">${st}</span></div><div>Purpose: <b>${prf.purpose||"-"}</b></div><div>Percentage: <b>${prf.percentage||0}%</b></div><div>Panel: <b>${prf.panel_customer||"-"}</b></div>`); }
    render_decision(){ const ctx=this.state.context||{}; let d=ctx.decision||null; if(!d){const t=this.getv("patient_type")||"Cash",s=this.getv("funding_source")||""; d={billing_type:t==="Welfare"&&s?`Welfare ${s}`:t,invoice_mode:t==="Cash"?"POS":"Non-POS",message:t==="Cash"?"Cash patient: collect Cash/Card.":"Non-cash billing will use approved setup."};} let cls=d.invoice_mode==="POS"?"green":(d.invoice_mode==="Blocked"?"red":"purple"); this.$root.find("[data-area='decision']").html(`<div>Billing Type: <span class="kpws-badge ${cls}">${d.billing_type||"-"}</span></div><div>Invoice Mode: <b>${d.invoice_mode||"-"}</b></div><div>Funding Source: <b>${d.funding_source||"-"}</b></div><div>Panel Customer: <b>${d.panel_customer||this.getv("panel_customer")||"-"}</b></div><div>Approved %: <b>${d.percentage||this.getv("approved_percentage")||0}%</b></div><div class="kpws-muted" style="margin-top:8px">${d.message||""}</div>`); }
};
