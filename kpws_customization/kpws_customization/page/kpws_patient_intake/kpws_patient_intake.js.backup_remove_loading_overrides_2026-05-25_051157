// KPWS_CLEAN_SEND_APPROVAL_EXTRA_FIELDS_V2
(function () {
    function install_clean_override() {
        if (typeof KPWSPatientIntakeV80 === "undefined") {
            setTimeout(install_clean_override, 500);
            return;
        }

        if (KPWSPatientIntakeV80.prototype.__kpws_clean_send_approval_extra_fields_v2) {
            return;
        }

        KPWSPatientIntakeV80.prototype.__kpws_clean_send_approval_extra_fields_v2 = true;

        const oldPayload = KPWSPatientIntakeV80.prototype.payload;

        KPWSPatientIntakeV80.prototype.payload = function () {
            const p = oldPayload.call(this) || {};

            const religion = $('#kpws_patient_religion').val() || '';
            const sanction = $('#kpws_patient_sanction').val() || '';
            const nationality = $('#kpws_patient_nationality').val() || '';

            p.custom_religion = religion;
            p.custom_sanction = sanction;
            p.custom_nationality = nationality;

            p.religion = religion;
            p.religion1 = religion;
            p.sanction = sanction;
            p.saction1 = sanction;
            p.nationality = nationality;

            return p;
        };

        function refresh_patient_context(me, patient) {
            if (!patient) return;

            if (typeof me.load_context === "function") {
                
                    if (typeof me.load_context === "function") {
                        me.load_context(patient);
                    } else if (typeof me.load_patient_context === "function") {
                        me.load_patient_context(patient);
                    } else if (typeof me.render_context === "function") {
                        me.api("get_patient_context", {patient: patient}, function (ctxr) {
                            me.render_context(ctxr.message || {});
                        });
                    } else if (typeof me.render_patient_context === "function") {
                        me.api("get_patient_context", {patient: patient}, function (ctxr) {
                            me.render_patient_context(ctxr.message || {});
                        });
                    } else {
                        console.log("KPWS: welfare registration created/updated for", patient);
                    }

                return;
            }

            if (typeof me.load_patient_context === "function") {
                me.load_patient_context(patient);
                return;
            }

            if (typeof me.refresh_context === "function") {
                me.refresh_context(patient);
                return;
            }

            if (typeof me.render_context === "function") {
                me.api("get_patient_context", {patient: patient}, function (r) {
                    me.render_context(r.message || {});
                });
                return;
            }

            if (typeof me.render_patient_context === "function") {
                me.api("get_patient_context", {patient: patient}, function (r) {
                    me.render_patient_context(r.message || {});
                });
                return;
            }

            console.log("KPWS: No context refresh method found. Saved patient:", patient);
        }

        KPWSPatientIntakeV80.prototype.send_approval = function () {
            const me = this;
            const p = me.payload();

            const patient_type = p.patient_type || p.customer_group || $('#patient_type').val() || $('#customer_group').val();

            if (patient_type !== "Welfare") {
                frappe.msgprint("Please select Patient Type as Welfare first.");
                return;
            }

            frappe.dom.freeze("Saving patient details...");

            me.api("save_patient", {
                payload: JSON.stringify(p)
            }, function (r) {
                const ctx = r.message || {};
                const patient = ctx.patient || ctx.name || me.current_patient || p.patient || p.name || p.patient_id;

                if (!patient) {
                    frappe.dom.unfreeze();
                    frappe.msgprint("Patient was saved, but Patient ID was not returned. Please refresh and try again.");
                    return;
                }

                me.current_patient = patient;

                const funding_source =
                    p.funding_source ||
                    p.custom_kpws_funding_source ||
                    $('#funding_source').val() ||
                    $('#custom_kpws_funding_source').val() ||
                    "";

                const percentage =
                    p.percentage ||
                    p.coverage_percentage ||
                    p.custom_coverage_percentage ||
                    p.custom_kpws_welfare_percentage ||
                    $('#coverage_percentage').val() ||
                    $('#custom_coverage_percentage').val() ||
                    $('#custom_kpws_welfare_percentage').val() ||
                    100;

                const panel_customer =
                    p.panel_customer ||
                    p.custom_panel_customer ||
                    $('#panel_customer').val() ||
                    $('#custom_panel_customer').val() ||
                    "";

                frappe.dom.freeze("Sending for welfare approval...");

                me.api("create_or_update_registration", {
                    patient: patient,
                    funding_source: funding_source,
                    percentage: percentage,
                    panel_customer: panel_customer,

                    religion: $('#kpws_patient_religion').val() || '',
                    sanction: $('#kpws_patient_sanction').val() || '',
                    nationality: $('#kpws_patient_nationality').val() || ''
                }, function (res) {
                    frappe.dom.unfreeze();

                    const msg = res.message || {};

                    if (msg.welfare_registration && msg.welfare_registration.name) {
                        me.latest_prf = msg.welfare_registration.name;
                    }

                    refresh_patient_context(me, patient);

                    frappe.show_alert({
                        message: "Sent for welfare approval.",
                        indicator: "green"
                    });
                });
            });
        };

        console.log("KPWS clean Send Welfare Approval extra fields override installed.");
    }

    install_clean_override();
})();


// KPWS_FIX_WELFARE_FUNDING_PAYLOAD_V1
(function () {
    function install_funding_payload_fix() {
        if (typeof KPWSPatientIntakeV80 === "undefined") {
            setTimeout(install_funding_payload_fix, 500);
            return;
        }

        if (KPWSPatientIntakeV80.prototype.__kpws_fix_welfare_funding_payload_v1) {
            return;
        }

        KPWSPatientIntakeV80.prototype.__kpws_fix_welfare_funding_payload_v1 = true;

        const oldPayload = KPWSPatientIntakeV80.prototype.payload;

        function val(ids) {
            for (const id of ids) {
                const $el = $('#' + id);
                if ($el.length && $el.val()) {
                    return $el.val();
                }
            }

            for (const id of ids) {
                const $el = $('[name="' + id + '"], [data-fieldname="' + id + '"] input, [data-fieldname="' + id + '"] select').first();
                if ($el.length && $el.val()) {
                    return $el.val();
                }
            }

            return "";
        }

        KPWSPatientIntakeV80.prototype.payload = function () {
            const p = oldPayload.call(this) || {};

            const patientType = val([
                'patient_type',
                'customer_group',
                'patient_billing_type',
                'custom_patient_billing_type'
            ]) || p.patient_type || p.customer_group || "";

            const fundingSource = val([
                'funding_source',
                'custom_kpws_funding_source',
                'custom_assistance_type',
                'assistance_type',
                'welfare_type',
                'custom_kpws_welfare_type'
            ]) || p.funding_source || p.custom_kpws_funding_source || p.custom_assistance_type || "";

            const percentage = val([
                'coverage_percentage',
                'custom_coverage_percentage',
                'custom_kpws_welfare_percentage',
                'percentage'
            ]) || p.percentage || p.custom_kpws_welfare_percentage || p.custom_coverage_percentage || 100;

            const panelCustomer = val([
                'panel_customer',
                'custom_panel_customer',
                'custom_kpws_assigned_panel_customer'
            ]) || p.panel_customer || p.custom_panel_customer || "";

            p.patient_type = patientType;
            p.customer_group = patientType;

            p.funding_source = fundingSource;
            p.custom_kpws_funding_source = fundingSource;
            p.custom_assistance_type = fundingSource;
            p.custom_kpws_welfare_type = fundingSource;

            p.percentage = percentage;
            p.coverage_percentage = percentage;
            p.custom_coverage_percentage = percentage;
            p.custom_kpws_welfare_percentage = percentage;

            p.panel_customer = panelCustomer;
            p.custom_panel_customer = panelCustomer;
            p.custom_kpws_assigned_panel_customer = panelCustomer;

            // Keep Religion / Sanction / Nationality in the same real payload
            p.custom_religion = $('#kpws_patient_religion').val() || p.custom_religion || "";
            p.custom_sanction = $('#kpws_patient_sanction').val() || p.custom_sanction || "";
            p.custom_nationality = $('#kpws_patient_nationality').val() || p.custom_nationality || "";

            p.religion = p.custom_religion;
            p.religion1 = p.custom_religion;
            p.sanction = p.custom_sanction;
            p.saction1 = p.custom_sanction;
            p.nationality = p.custom_nationality;

            return p;
        };

        console.log("KPWS welfare funding payload fix installed.");
    }

    install_funding_payload_fix();
})();
