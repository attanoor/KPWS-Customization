/* KPWS_EXTRA_PATIENT_FIELDS_DIRECT_PATCH_V1 */
(function () {
    const old_on_page_load = frappe.pages['kpws-patient-intake'].on_page_load;

    frappe.pages['kpws-patient-intake'].on_page_load = function (wrapper) {
        if (old_on_page_load) {
            old_on_page_load(wrapper);
        }

        setTimeout(function () {
            kpws_add_extra_patient_fields_direct(wrapper);
        }, 800);
    };

    function kpws_add_extra_patient_fields_direct(wrapper) {
        const $wrapper = $(wrapper);

        if ($wrapper.find("#kpws-extra-patient-fields-direct").length) {
            return;
        }

        let $target = $wrapper.find(".layout-main-section").first();

        if (!$target.length) {
            $target = $wrapper.find(".page-content").first();
        }

        if (!$target.length) {
            $target = $wrapper;
        }

        const html = `
            <div id="kpws-extra-patient-fields-direct" style="
                background: #ffffff;
                border: 1px solid #dbeafe;
                border-radius: 12px;
                padding: 14px;
                margin: 12px 0 16px 0;
                box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
            ">
                <div style="
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 12px;
                    margin-bottom: 12px;
                ">
                    <div>
                        <div style="font-size: 16px; font-weight: 700; color: #111827;">
                            Patient Extra Details
                        </div>
                        <div style="font-size: 12px; color: #6b7280;">
                            Religion, Sanction and Nationality
                        </div>
                    </div>

                    <button class="btn btn-sm btn-primary" id="kpws-extra-save-direct">
                        Save Extra Details
                    </button>
                </div>

                <div style="
                    display: grid;
                    grid-template-columns: repeat(5, minmax(160px, 1fr));
                    gap: 12px;
                ">
                    <div>
                        <label style="font-weight: 600;">Patient</label>
                        <input type="text" class="form-control" id="kpws_extra_patient_direct" placeholder="Patient ID">
                    </div>

                    <div>
                        <label style="font-weight: 600;">Registration Form</label>
                        <input type="text" class="form-control" id="kpws_extra_prf_direct" placeholder="PRF ID">
                    </div>

                    <div>
                        <label style="font-weight: 600;">Religion</label>
                        <input type="text" class="form-control" id="kpws_extra_religion_direct" placeholder="Religion">
                    </div>

                    <div>
                        <label style="font-weight: 600;">Sanction</label>
                        <input type="text" class="form-control" id="kpws_extra_sanction_direct" placeholder="Sanction">
                    </div>

                    <div>
                        <label style="font-weight: 600;">Nationality</label>
                        <input type="text" class="form-control" id="kpws_extra_nationality_direct" placeholder="Nationality">
                    </div>
                </div>
            </div>
        `;

        $target.prepend(html);

        function get_existing_value(possible_ids) {
            for (const id of possible_ids) {
                const $el = $wrapper.find(`#${id}, [name="${id}"], [data-fieldname="${id}"] input`).first();
                if ($el.length && $el.val()) {
                    return $el.val();
                }
            }
            return "";
        }

        function get_patient() {
            return $("#kpws_extra_patient_direct").val()
                || get_existing_value(["patient", "patient_id", "custom_patient", "patient_name"]);
        }

        function get_prf() {
            return $("#kpws_extra_prf_direct").val()
                || get_existing_value(["patient_registration_form", "registration_form", "prf", "registration_id"]);
        }

        function load_extra_fields() {
            const patient = get_patient();
            const prf = get_prf();

            if (!patient && !prf) {
                return;
            }

            if (patient && !$("#kpws_extra_patient_direct").val()) {
                $("#kpws_extra_patient_direct").val(patient);
            }

            if (prf && !$("#kpws_extra_prf_direct").val()) {
                $("#kpws_extra_prf_direct").val(prf);
            }

            frappe.call({
                method: "kpws_customization.api.kpws_patient_extra_fields.get_extra_fields",
                args: {
                    patient: patient,
                    patient_registration_form: prf
                },
                callback: function (r) {
                    const data = r.message || {};
                    $("#kpws_extra_religion_direct").val(data.religion || "");
                    $("#kpws_extra_sanction_direct").val(data.sanction || "");
                    $("#kpws_extra_nationality_direct").val(data.nationality || "");
                }
            });
        }

        $("#kpws_extra_patient_direct, #kpws_extra_prf_direct").on("change blur", load_extra_fields);

        $("#kpws-extra-save-direct").on("click", function () {
            const patient = get_patient();
            const prf = get_prf();

            frappe.call({
                method: "kpws_customization.api.kpws_patient_extra_fields.save_extra_fields",
                args: {
                    patient: patient,
                    patient_registration_form: prf,
                    religion: $("#kpws_extra_religion_direct").val() || "",
                    sanction: $("#kpws_extra_sanction_direct").val() || "",
                    nationality: $("#kpws_extra_nationality_direct").val() || ""
                },
                freeze: true,
                freeze_message: __("Saving extra details..."),
                callback: function (r) {
                    if (r.message && r.message.ok) {
                        frappe.show_alert({
                            message: __("Extra patient details saved"),
                            indicator: "green"
                        });
                    }
                }
            });
        });

        setTimeout(load_extra_fields, 1000);
    }
})();

