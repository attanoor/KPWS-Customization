 "font_size": 14,
 "html": "<style>\n \n \n  .print-format {\n      font-family: Arial, sans-serif;\n      font-size: 12px;\n      color: #000;\n  }\n\n  /* Header Section */\n  .header-top {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      border-bottom: 1px solid #000;\n      padding-bottom: 4px;\n      margin-bottom: 8px;\n  }\n  .header-top-left {\n      font-size: 16px;\n      font-weight: bold;\n      text-transform: uppercase;\n  }\n  .header-top-right {\n      font-size: 16px;\n      font-weight: bold;\n      text-transform: uppercase;\n  }\n\n  /* Sub Header */\n  .header-sub {\n      display: flex;\n      justify-content: space-between;\n      border-bottom: 1px solid #000;\n      padding-bottom: 3px;\n      margin-bottom: 6px;\n  }\n\n  /* Table Styling */\n  .table {\n      width: 100%;\n      border-collapse: collapse;\n      border-spacing: 0;\n      /*margin-top: 6px;*/\n      border: 1px solid #000;\n  }\n\n  .table th, .table td {\n      border: 1px solid #000;\n      padding: 0;              /* Tight layout - no gaps */\n      /*line-height: 1.15;*/\n      vertical-align: middle;\n  }\n\n  .table th {\n      background: #f5f5f5;\n      font-weight: 100;\n      font-size:10px;\n      text-align: left;\n  }\n\n  .table td {\n      text-align: left;\n            font-size:10px;\n\n  }\n\n  .table td.num {\n      text-align: right;\n  }\n\n  .totals {\n      text-align: right;\n      font-weight: bold;\n  }\n\n  /* Amount in Words */\n  .amount-words {\n      margin-top: 10px;\n  }\n\n  /* Signatures */\n  .signatures {\n      margin-top: 40px;\n      display: flex;\n      justify-content: space-between;\n  }\n  \n  /* Footer Page Number */\n  .footer {\n      position: fixed;\n      bottom: 0;\n      left: 0;\n      width: 100%;\n      text-align: center;\n      font-size: 11px;\n      color: #555;\n      border-top: 1px solid #ccc;\n      padding-top: 5px;\n  }\n\n  .pagenum:before {\n      content: counter(page);\n  }\n  .pagecount:before {\n      content: counter(pages);\n  }\n</style>\n\n<div class=\"print-format\">\n\n    <!-- Header -->\n    <div class=\"header-top\">\n        <div class=\"header-top-left\">KIRAN PATIENT WELFARE SOCIETY (KPWS)</div>\n        <div class=\"header-top-right\">{{ doc.voucher_type or \"Journal Entry\" }}</div>\n    </div>\n\n    <div class=\"header-sub\">\n        <div><b>Voucher Date:</b> {{ doc.posting_date }}</div>\n        <div><b>Voucher ID:</b> {{ doc.name }}</div>\n    </div>\n\n    <p><b>Description:</b> {{ doc.user_remark or doc.remark or \"\" }}</p>\n\n    <!-- Table -->\n    <table class=\"table\">\n        <thead>\n            <tr>\n                <th>Account Name</th>\n                <th>Description</th>\n                <th style=\"text-align:right;\">Debit (PKR)</th>\n                <th style=\"text-align:right;\">Credit (PKR)</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.accounts %}\n            <tr>\n                <td>{{ frappe.db.get_value(\"Account\", row.account, \"account_name\") }}</td>\n                <td>{{ row.user_remark or row.reference_name or \"\" }}</td>\n                <td class=\"num\">{{ \"{:,.2f}\".format(row.debit or 0) }}</td>\n                <td class=\"num\">{{ \"{:,.2f}\".format(row.credit or 0) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n        <tfoot>\n            <tr>\n                <td colspan=\"2\" class=\"totals\">Total</td>\n                <td class=\"num\">{{ \"{:,.2f}\".format(doc.total_debit or 0) }}</td>\n                <td class=\"num\">{{ \"{:,.2f}\".format(doc.total_credit or 0) }}</td>\n            </tr>\n        </tfoot>\n    </table>\n\n    <p class=\"amount-words\"><b>Amount in Words:</b> {{ frappe.utils.money_in_words(doc.total_debit or 0, doc.currency) }}</p>\n\n    <!-- Signatures -->\n    <div class=\"signatures\">\n        <div>\n            _________________________<br>\n            <b>    Accountant</b>\n        </div>\n        <div style=\"text-align:right;\">\n            _________________________<br>\n            <b>Administrator</b>\n    \n        </div>\n        \n\n    </div>\n    \n\n</div>\n",
