 "doc_type": "Purchase Receipt",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n  @page { size: A4 landscape; margin: 10mm 10mm 10mm 12mm; }\n  html, body { font-family: Arial, Helvetica, sans-serif; color:#111; font-size: 11px; }\n  .wrap { width:100%; }\n\n  /* Header */\n  .top { display:grid; grid-template-columns: 1fr 360px; gap:10px; align-items:start; }\n  .title { font-size:18px; font-weight:800; text-transform:uppercase; letter-spacing:.3px; }\n  .box { border:1px solid #111; padding:8px 10px; }\n  .grid2 { display:grid; grid-template-columns: 130px 6px 1fr; row-gap:4px; column-gap:6px; }\n  .lbl { font-weight:700; }\n  .right-head .grid2 { grid-template-columns: 120px 6px 1fr; }\n\n  .hr { border:0; border-top:1.6px solid #111; margin:8px 0 10px; }\n\n  table { width:100%; border-collapse:collapse; }\n  th, td { border:1px solid #111; padding:6px 7px; vertical-align:top; }\n  thead th { text-align:center; font-weight:800; background:#f6f6f6; }\n  .num { text-align:right; } .center { text-align:center; } .muted { color:#333; }\n\n  /* column widths tuned for one-row per item */\n  .w-sr{ width:28px; }\n  .w-med{ width:24%; }\n  .w-code{ width:90px; }\n  .w-unit{ width:60px; }\n  .w-order{ width:70px; }\n  .w-prev{ width:70px; }\n  .w-batch{ width:100px; }\n  .w-exp{ width:90px; }\n  .w-acc{ width:70px; }\n  .w-trec{ width:80px; }\n  .w-pend{ width:70px; }\n  .w-rate{ width:75px; }\n  .w-amt{ width:95px; }\n\n  /* footer/signatures */\n  .foot { margin-top:18px; display:grid; grid-template-columns: 1fr 1fr; gap:40px; }\n  .sigline { margin-top:48px; border-top:1px solid #111; width:80%; }\n</style>\n\n<div class=\"wrap\">\n  <div class=\"top\">\n    <div class=\"left-head\">\n      <div class=\"title\">{{ doc.company or \"KIRAN PATIENT WELFARE SOCIETY (K.P.W.S)\" }}</div>\n      <div class=\"box\">\n        <div class=\"grid2\">\n          <div class=\"lbl\">GRN No</div><div>:</div><div>{{ doc.name }}</div>\n          <div class=\"lbl\">GRN Date</div><div>:</div><div>{{ frappe.utils.formatdate(doc.posting_date) }}</div>\n          <div class=\"lbl\">Supplier</div><div>:</div><div>{{ doc.supplier_name or doc.supplier }}</div>\n          <div class=\"lbl\">Remarks</div><div>:</div><div>{{ doc.remarks or \"\" }}</div>\n        </div>\n      </div>\n    </div>\n    <div class=\"right-head\">\n      <div class=\"box\">\n        <div class=\"grid2\">\n          <div class=\"lbl\">PO No</div><div>:</div><div>\n            {% set po = \"\" %}\n            {% for i in doc.items %}\n              {% if i.purchase_order and not po %}{% set po = i.purchase_order %}{% endif %}\n            {% endfor %}\n            {{ po }}\n          </div>\n\n          <div class=\"lbl\">PO Date</div><div>:</div><div>\n            {% if po %}{{ frappe.utils.formatdate(frappe.db.get_value(\"Purchase Order\", po, \"transaction_date\")) }}{% endif %}\n          </div>\n\n          <div class=\"lbl\">DC/Invoice No</div><div>:</div><div>{{ doc.supplier_delivery_note or doc.bill_no or \"\" }}</div>\n          <div class=\"lbl\">DC/Invoice Date</div><div>:</div><div>{{ frappe.utils.formatdate(doc.bill_date) if doc.bill_date else \"\" }}</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <hr class=\"hr\" />\n\n  <!-- ONE ROW PER ITEM -->\n  <table>\n    <thead>\n      <tr>\n        <th class=\"w-sr\">S.No</th>\n        <th class=\"w-med\">Medicine</th>\n        <th class=\"w-code\">Code</th>\n        <th class=\"w-unit\">Unit</th>\n        <th class=\"w-order\">Order Qty</th>\n        <th class=\"w-prev\">Prev Rec Qty</th>\n        <th class=\"w-batch\">Batch No</th>\n        <th class=\"w-exp\">Expiry Date</th>\n        <th class=\"w-acc\">Accepted Qty</th>\n        <th class=\"w-trec\">Total Rec Qty</th>\n        <th class=\"w-pend\">Pending Qty</th>\n        <th class=\"w-rate\">Rate</th>\n        <th class=\"w-amt\">Inv. Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for i in doc.items %}\n      <tr>\n        <td class=\"center\">{{ loop.index }}</td>\n        <td>\n          <div><b>{{ i.item_name or i.description or i.item_code }}</b></div>\n          {% if i.description and (i.item_name and i.description != i.item_name) %}\n            <div class=\"muted\">{{ i.description }}</div>\n          {% endif %}\n        </td>\n        <td class=\"center\">{{ i.item_code }}</td>\n        <td class=\"center\">{{ i.uom or i.stock_uom }}</td>\n        <td class=\"num\">{{ i.order_qty or 0 }}</td>\n        <td class=\"num\">{{ i.prev_received_qty or 0 }}</td>\n        <td class=\"center\">{{ i.batch_no or \"\" }}</td>\n        <td class=\"center\">{{ i.batch_expiry_date and frappe.utils.formatdate(i.batch_expiry_date) or \"\" }}</td>\n        <td class=\"num\">{{ i.accepted_qty or i.qty or 0 }}</td>\n        <td class=\"num\">{{ i.total_received_upto or 0 }}</td>\n        <td class=\"num\">{{ i.pending_qty or 0 }}</td>\n        <td class=\"num\">{{ \"{:,.2f}\".format((i.rate or 0)|float) }}</td>\n        <td class=\"num\">{{ \"{:,.2f}\".format((i.inv_amount or 0)|float) }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <!-- Footer / Signatures -->\n  <div class=\"foot\">\n    <div>\n      <div class=\"lbl\">Received By:</div>\n      <div class=\"sigline\"></div>\n    </div>\n    <div style=\"text-align:right;\">\n      <div class=\"lbl\">Warehouse Incharge:</div>\n      <div class=\"sigline\" style=\"margin-left:auto;\"></div>\n    </div>\n  </div>\n</div>\n",
 "idx": 0,
 "line_breaks": 0,
